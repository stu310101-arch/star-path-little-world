# Rebuildable editor/cache output and local review artifacts.
**/.godot/
**/*.blend1
**/__pycache__/
*.pyc
/build/
/game/assets/fonts/web/
/_site/
/deliverables/
/assets/
/PROGRESS_PAUSED.md

# Keep the editable room and lake masters in the repository; older art
# experiments and source attachments stay in the local workspace.
/art/*
!/art/TrainingRoom/
!/art/Ecology/
!/art/UniversityHall/
!/art/Vehicles/
!/art/Vessels/
!/art/Vegetation/
!/art/FurinaDisplay/
!/art/AdmissionsRoom/
!/art/CounselingRoom/
!/art/RecommendationRoom/
/art/AdmissionsRoom/*.png
/art/FurinaDisplay/*
!/art/FurinaDisplay/Furina-Holding-Splendor.blend
!/art/FurinaDisplay/export-report.json
/art/Vehicles/*.png
/art/Vessels/*.png
/art/Vegetation/*.png
/art/UniversityHall/*.png
/art/UniversityHall/revision_*/
/art/UniversityHall/inspect_*.gd
/art/UniversityHall/*.blend
!/art/UniversityHall/UniversityHall_Library.blend
!/art/UniversityHall/UniversityHall_ExhibitKit.blend
/art/TrainingRoom/*
!/art/TrainingRoom/WordKing_TrainingRoom.blend
!/art/TrainingRoom/WordKing_TrainingRoom_Game.blend
!/art/TrainingRoom/*.md
/art/Ecology/*
!/art/Ecology/bank_stones.blend
!/art/Ecology/BANK_STONES_REVISION.md

# Local temporary files.
*.log
*.tmp
/admissions-site/
/wordking-source/
**/node_modules/
**/.wrangler/
**/.dev.vars
**/.env*
!**/.env.example
/tools/*.json
/tools/*.err
/tools/*.npz
/tools/*.png

# Godot extracts these duplicate GLB images; canonical textures stay in textures/.
/game/assets/counseling_room/counseling_room_*.png
/game/assets/counseling_room/counseling_room_*.png.import
/game/assets/recommendation_room/recommendation_room_*.png
/game/assets/recommendation_room/recommendation_room_*.png.import
/game/generated/low/recommendation/recommendation_room_*.png
/game/generated/low/recommendation/recommendation_room_*.png.import
/game/assets/university_hall/atrium_*.png
/game/assets/university_hall/atrium_*.png.import
/game/assets/university_hall/booth_*.png
/game/assets/university_hall/booth_*.png.import
/game/assets/university_hall/gallery_*.png
/game/assets/university_hall/gallery_*.png.import
/game/assets/university_hall/exhibit_kit_*.png
/game/assets/university_hall/exhibit_kit_*.png.import
/game/assets/university_hall/theme_*.png
/game/assets/university_hall/theme_*.png.import
/game/assets/university_hall/feature_*.png
/game/assets/university_hall/feature_*.png.import
