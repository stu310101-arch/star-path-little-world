+const filled = () => { const profile = emptyInterestProfile(); for (const key in profile.riasec) profile.riasec[key] = "0"; for (const key in profile.knowledge) profile.knowledge[key] = "18"; return profile; };
+describe("interest scores and the constrained native protocol", () => {
+  it("locks all 39 required IDs and reuses the 18 official group IDs", () => {
+    expect(INTEREST_CATALOG.riasec).toHaveLength(6); expect(INTEREST_CATALOG.knowledge).toHaveLength(33);
+    expect(INTEREST_CATALOG.groups.map(group => group.id)).toEqual(LEARNING_GROUP_OPTIONS.map(group => group.id));
+    expect(INTEREST_CATALOG.knowledge.at(-1)).toEqual({ id: "k33", label: "交通運輸" });
+    const shared = new URL("../../game/data/interest_catalog.json", import.meta.url);
+    // The admissions source can also be restored and tested on its own.
+    if (existsSync(shared)) expect(JSON.parse(readFileSync(shared, "utf8"))).toEqual(INTEREST_CATALOG);
+  });
+  it("preserves unfinished and temporarily invalid draft text without turning blanks into zero", () => {
+    const profile = emptyInterestProfile(); profile.riasec.R = "-"; profile.knowledge.k01 = "還沒查"; profile.riasecDate = "2026-";
+    profile.bestFits = [{ groupId: "", category: "藝術與設計", z: "-" }];
+    expect(validateInterestProfile(profile)).toEqual(profile); expect(() => validateInterestProfile(profile, true)).toThrow();
+  });
+  it("fixes high1/high3 assessment semantics without adding fields to existing version 1 records", () => {
+    expect(INTEREST_CATALOG.catalogVersion).toBe(1);
+    expect(INTEREST_CATALOG.assessments).toEqual([
+      { id: "interest", stageCode: "high1", stageLabel: "高一", title: "興趣量表", sections: ["riasec"] },
+      { id: "department-exploration", stageCode: "high3", stageLabel: "高三", title: "學系探索量表", sections: ["knowledge", "bestFits", "suitableFits"] },
+    ]);
+    const existing = filled(); existing.riasecDate = "2024-10-21"; existing.knowledgeDate = "2026-10-24";
+    expect(validateInterestProfile(existing)).toEqual(existing);
+    const completed = validateInterestProfile(existing, true);
+    expect(Object.keys(completed)).toEqual(Object.keys(existing));
+    expect(completed.riasecDate).toBe("2024-10-21"); expect(completed.knowledgeDate).toBe("2026-10-24");
+    expect(completed.catalogVersion).toBe(1);
+  });
+  it("completes zero and boundary scores, legacy date strings and signed Z beyond 25 rows", () => {
+    const profile = filled(); profile.riasec.R = "090"; profile.title = "  秋季量表  "; profile.riasecDate = "2024-02-29";
+    profile.bestFits = Array.from({ length: 26 }, (_, i) => ({ groupId: "arts", category: `藝術 ${i}`, z: "-.25" }));
+    profile.suitableFits = [{ groupId: "", category: "", z: "" }, { groupId: "information", category: "資訊", z: "+0.30" }];
+    const completed = validateInterestProfile(profile, true);
+    expect(completed.riasec.R).toBe("90"); expect(completed.riasec.I).toBe("0"); expect(completed.bestFits).toHaveLength(26);
+    expect(completed.bestFits[0].z).toBe("-0.25"); expect(completed.suitableFits).toHaveLength(1); expect(completed.suitableFits[0].z).toBe("0.3");
+    expect(completed.title).toBe("秋季量表"); expect(completed.knowledgeDate).toBe("");
+  });
+  it("rejects missing scores, fractions, range overflow and half-filled fit rows", () => {
+    for (const mutate of [(p: ReturnType<typeof filled>) => { delete p.knowledge.k33; }, (p: ReturnType<typeof filled>) => { p.riasec.R = "91"; },
+      (p: ReturnType<typeof filled>) => { p.knowledge.k01 = "18.5"; },
+      (p: ReturnType<typeof filled>) => { p.bestFits = [{ groupId: "arts", category: "", z: "0" }]; },
+      (p: ReturnType<typeof filled>) => { p.bestFits = [{ groupId: "arts", category: "藝術", z: "Infinity" }]; }]) {
+      const profile = filled(); mutate(profile); expect(() => validateInterestProfile(profile, true)).toThrow();
+    }
+  });
+  it("rejects duplicate fit identity across both levels and keeps tiny decimal Z round-trippable", () => {
+    const profile = filled(); profile.bestFits = [{ groupId: "arts", category: "Design", z: "0.000000100" }];
+    const saved = validateInterestProfile(profile, true); expect(saved.bestFits[0].z).toBe("0.0000001");
+    expect(validateInterestProfile(saved, true)).toEqual(saved);
+    profile.suitableFits = [{ groupId: "arts", category: " design ", z: "0.3" }];
+    expect(() => validateInterestProfile(profile, true)).toThrow(/重複/);
+    expect(validateInterestProfile(profile).suitableFits).toHaveLength(1);
+  });
+  it("preserves hidden incomplete legacy dates through completion without requiring date input", () => {
+    const profile = filled(); profile.riasecDate = " 2024- "; profile.knowledgeDate = "尚未填完";
+    const completed = validateInterestProfile(profile, true);
+    expect(completed.riasecDate).toBe(" 2024- "); expect(completed.knowledgeDate).toBe("尚未填完");
+    expect(emptyInterestProfile()).toMatchObject({ riasecDate: "", knowledgeDate: "" });
+    profile.riasecDate = "x".repeat(33);
+    expect(() => validateInterestProfile(profile, true)).toThrow();
+  });
+  it("accepts 4KiB+ profiles, rejects unknown ownership fields and enforces the 64KiB channel", () => {
+    const profile = filled(); profile.bestFits = Array.from({ length: 60 }, () => ({ groupId: "arts", category: "藝術設計與創作", z: "-0.25" }));
+    const command = { action: "complete", requestId: "r1", sessionGeneration: 3, recordId: "record1", expectedRevision: 0, profile };
+    expect(interestBytes(command)).toBeGreaterThan(4096); expect(readInterestCommand(command)).not.toBeNull();
+    expect(readInterestCommand({ ...command, uid: "another-account" })).toBeNull();
+    expect(readInterestCommand({ ...command, profile: { ...profile, token: "never" } })).toBeNull();
+    expect(readInterestCommand(" ".repeat(65537))).toBeNull();
+  });
+  it("emits safe completion errors and discards responses from invalidated sessions", async () => {
+    const command = readInterestCommand({ action: "complete", requestId: "r", sessionGeneration: 3, recordId: "one", expectedRevision: 0, profile: filled() })!;
+    const packets: Record<string, unknown>[] = [];
+    const repository = { save: async () => { throw Object.assign(new Error("conflict"), { code: "cloud-revision-conflict" }); } } as unknown as InterestRepository;
+    await executeInterestCommand(command, repository, () => true, packet => packets.push(packet));
+    expect(packets[0]).toMatchObject({ type: "error", code: "cloud-revision-conflict", requestId: "r" });
+    let current = true;
+    const stale = { save: async () => { current = false; return {}; } } as unknown as InterestRepository;
+    await executeInterestCommand(command, stale, () => current, packet => packets.push(packet));
+    expect(packets).toHaveLength(1);
+  });
+});
