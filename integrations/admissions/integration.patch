+import { describe, expect, it } from "vitest";
+import { mergeUniversityProgress, validateGoSave } from "../lib/progressRepository";
+
+describe("private game progress", () => {
+  it("uses explicit favorite state, preserves removal across local import, and unions exploration", () => {
+    let current = { favorites: {}, explored: ["001"], revision: 0 };
+    current = mergeUniversityProgress(current, { id: "001", favorite: true });
+    current = mergeUniversityProgress(current, { id: "001", favorite: false });
+    const result = mergeUniversityProgress(current, { import: { favorite_ids: ["001", "002"], visited_ids: ["001", "003"] } });
+    expect(result.favorites).toEqual({ "001": false, "002": true }); expect(result.explored).toEqual(["001", "003"]);
+    expect(mergeUniversityProgress(result, { id: "001", favorite: false }).favorites["001"]).toBe(false);
+  });
+  it("rejects paths and malformed save history", () => {
+    expect(() => mergeUniversityProgress({ favorites: {}, explored: [], revision: 0 }, { id: "../someone", favorite: true })).toThrow();
+    expect(() => validateGoSave({ version: 1, game: { size: 9, komi: 6.5, board: Array(81).fill(0), history: [], moveNumber: 3 }, settings: { mode: "local", difficulty: "easy" } })).toThrow();
+  });
+  it("keeps complete Go state and does not convert it to a local ownerless save", () => {
+    const state = { version: 1, started: true, game: { size: 9, komi: 6.5, board: Array(81).fill(0), history: [], moveNumber: 0 }, settings: { mode: "local", difficulty: "easy" }, dead: [] };
+    expect(validateGoSave(state)).toEqual(state);
+  });
+});
