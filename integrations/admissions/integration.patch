@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vitest";
+import { createHash } from "node:crypto";
+import { createVerifier, readHostCommand, validApprovalUrl, validOfficialUrl } from "../lib/hostProtocol";
+describe("host credential boundary", () => {
+  it("accepts only versioned navigation and sign-out commands", () => {
+    expect(readHostCommand({ channel: "starpath-account", version: 1, type: "navigate", view: "scores" })).toEqual({ type: "navigate", view: "scores" });
+    expect(readHostCommand({ channel: "starpath-account", version: 1, type: "suspend" })).toEqual({ type: "suspend" });
+    for (const view of ["general", "special", "apcs"]) expect(readHostCommand({ channel: "starpath-account", version: 1, type: "navigate", view })).toEqual({ type: "navigate", view });
+    for (const value of [null, { channel: "wrong", version: 1, type: "sign-out" }, { channel: "starpath-account", version: 2, type: "sign-out" }, { channel: "starpath-account", version: 1, type: "navigate", view: "https://evil.example" }]) {
+      expect(readHostCommand(value)).toBeNull();
+    }
+  });
+  it("opens only HTTPS official admission sources outside the native container", () => {
+    expect(validOfficialUrl("https://daa.cpu.edu.tw/p/406-1033-43854%2Cr35.php")).toBe(true);
+    expect(validOfficialUrl("https://www.cac.edu.tw/apply115/system/program.html")).toBe(true);
+    expect(validOfficialUrl("https://daa.cpu.edu.tw/unrelated/")).toBe(false);
+    expect(validOfficialUrl("https://www.cac.edu.tw/other/../apply115/system/program.html")).toBe(false);
+    for (const url of ["http://daa.cpu.edu.tw/", "https://daa.cpu.edu.tw.evil.test/", "https://evil.test/", "https://user@daa.cpu.edu.tw/", "https://daa.cpu.edu.tw:8080/"]) expect(validOfficialUrl(url)).toBe(false);
+  });
+  it("keeps external native login inside the exact origin and pairing route", () => {
+    const origin = "https://world.example";
+    const path = "/admissions/account/native/?requestId=abcdefgh1234567890";
+    expect(validApprovalUrl(origin + path, origin, "/admissions")).toBe(true);
+    expect(validApprovalUrl("https://evil.example" + path, origin, "/admissions")).toBe(false);
+    expect(validApprovalUrl(origin + "/other/?requestId=abcdefgh1234567890", origin, "/admissions")).toBe(false);
+    expect(validApprovalUrl("javascript:alert(1)", origin, "/admissions")).toBe(false);
+  });
+  it("uses a random verifier and the backend-compatible SHA256 hex encoding", async () => {
+    const first = await createVerifier(); const second = await createVerifier();
+    expect(first.verifier).toMatch(/^[A-Za-z0-9_-]{43}$/);
+    expect(first.verifierHash).toBe(createHash("sha256").update(first.verifier).digest("hex"));
+    expect(second.verifier).not.toBe(first.verifier);
+  });
+});
