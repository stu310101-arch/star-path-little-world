+        </section>}
+        {native && <p className="muted-copy">若要連結其他登入方式，請在系統瀏覽器的帳號頁操作。</p>}
+        <div className="cloud-actions"><a className="cloud-primary" href={sitePath(workbenchUtilityPath("/scores/", currentWorkbench(), lastAdmissionYear()))}>查看我的成績</a>
