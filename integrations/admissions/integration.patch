new file mode 100644
index 0000000000000000000000000000000000000000..1c88a5a80a639b6d81012aa5dbdf33591d9e8ef9
--- /dev/null
+++ b/public/games/go/index.html
@@ -0,0 +1,3529 @@
+<!DOCTYPE html>
+<html lang="zh-Hant">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="theme-color" content="#0a1019">
+<meta name="description" content="NEON GO 星弈：每次開新局先設定模式、難度與棋盤大小，確認後才開始對弈。單檔離線圍棋。">
+<title>NEON GO 星弈 · 單機圍棋</title>
+<style>
+:root {
+  color-scheme: dark;
+  --bg: #0a1019;
+  --surface: #111b28;
+  --raised: #182433;
+  --ink: #ecf2f9;
+  --muted: #9aaabd;
+  --line: #2b3a4b;
+  --accent: #65e4c7;
+  --danger: #ffc299;
+  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang TC", "Microsoft JhengHei", "Noto Sans CJK TC", sans-serif;
+  --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
+}
+* { box-sizing: border-box; }
+html { background: var(--bg); }
+body { margin: 0; min-height: 100vh; color: var(--ink); font: 14px/1.6 var(--sans); background: radial-gradient(ellipse at 50% -250px, #17313c66, transparent 700px), var(--bg); }
+button, select, input { font: inherit; }
+button, select { color: inherit; }
+button { cursor: pointer; touch-action: manipulation; }
+button, select { -webkit-tap-highlight-color: transparent; transition: background .15s, border-color .15s, color .15s; }
+button:disabled { cursor: not-allowed; color: #778698; }
+button svg, summary svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
+button:focus-visible, select:focus-visible, summary:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
+[tabindex="-1"]:focus { outline: none; }
+::selection { background: #65e4c73b; color: #fff; }
+[hidden] { display: none !important; }
+.sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
+.site-head { max-width: 984px; height: 68px; padding: 0 24px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid #2b3a4b99; }
+.brand { display: flex; align-items: center; gap: 10px; }
+.brand-mark { width: 28px; height: 28px; display: grid; place-items: center; border: 1px solid #3e615e; border-radius: 8px; background: #152a2b; }
+.brand-mark svg { width: 19px; height: 19px; }
+.brand-name { font: 600 16px/1 var(--mono); letter-spacing: .5px; }
+.brand-name span { color: var(--accent); }
