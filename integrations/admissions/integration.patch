+import { describe, expect, it, vi } from "vitest";
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { academicState, buildRecommendation, rankRecommendations, recommendationDetails, recommendationPoints, selectedFits } from "../lib/recommendationEngine";
+import * as engine from "../lib/recommendationEngine";
+import { recommendationDataset, type RecommendationDataset, type RecommendationMapping } from "../lib/recommendationData";
+import { defaultRecommendationSettings, recommendationBytes, validateRecommendationSettings, type RecommendationSettings } from "../lib/recommendationTypes";
+import { readRecommendationCommand, executeRecommendationCommand } from "../lib/recommendationProtocol";
+import { RecommendationService, yieldRecommendationWork } from "../lib/recommendationService";
+import { emptyInterestProfile } from "../lib/interestRecords";
+import type { ExamRecord } from "../lib/examRecords";
+import type { Program } from "../lib/types";
+import { transferProgramReferences } from "../lib/yearProgramSelection";
+
+const exam: ExamRecord = { id:"exam1",schemaVersion:1,kind:"mock",title:"合成測試成績",examDate:"2026-10-25",scores:{國文:10},apcsScores:{},updatedAtMillis:1 };
+const program = (code="001001",minimum=10):Program => ({year:115,schoolId:"001",schoolName:"測試大學",programCode:code,programName:`合成校系${code}`,groupTags:["自然組"],departmentKeywords:[],screeningRules:[{order:1,label:"國文",subjects:["國文"],minScore:minimum,rawText:""}],requirements:[],source:{collegeListUrl:"https://www.cac.edu.tw/apply115/system/list",reportHtmlUrl:"https://www.cac.edu.tw/apply115/system/report",reportImageUrl:"https://www.cac.edu.tw/apply115/system/image"},dataStatus:"complete",evaluationSupport:"supported",verified:true});
+const mapping = (category="資訊工程",groupId="information"):RecommendationMapping => ({groupIds:[groupId],pairs:[{groupId,category}],categories:[category],reliable:true,matchKind:"official-exact",crossDomain:false,sourceYear:"115",sourceUrl:"https://collego.edu.tw/Highschool/MajorList"});
+const settings=():RecommendationSettings => ({...defaultRecommendationSettings(),source:"manual",manual:[{groupId:"information",category:"資訊工程",level:2},{groupId:"engineering",category:"機械工程",level:1}],examId:"exam1"});
+function dataset(count=4):RecommendationDataset {
+  const programs=Array.from({length:count},(_,index)=>program(`001${String(index+1).padStart(3,"0")}`,index%2?12:10));
+  if(count>5)programs[count-1].requirements=[{subject:"英文",standard:"均標",minScore:8,rawText:"英文均標"}];
+  return {dataVersion:"synthetic-v1",aliases:{資工:"資訊工程"},catalog:[{groupId:"information",groupLabel:"資訊學群",category:"資訊工程"},{groupId:"engineering",groupLabel:"工程學群",category:"機械工程"}],schools:{"115:001":{schoolName:"測試大學",universityId:"001",match:"exact-name"}},mappings:Object.fromEntries(programs.map((row,index)=>[`115:${row.programCode}`,index<2?mapping():mapping("機械工程","engineering")])),programs:{"113":[],"114":[],"115":programs}};
+}
+function fakeService(data=dataset(25)) {
+  let live=true,clock=100;
+  const saved={getSettings:async()=>({settings:settings(),settingsRevision:0}),getFavorite:async(programRef:string)=>({programRef,value:false,revision:0,updatedAtMillis:0}),listFavoriteStates:async()=>({items:[],nextId:null}),saveSettings:async(input:unknown)=>({settings:validateRecommendationSettings(input),settingsRevision:1}),setFavorite:async(programRef:string,value:boolean)=>({programRef,value,revision:1})};
+  const service=new RecommendationService({current:()=>live,now:()=>clock,load:async()=>({dataset:data,engine}),yield:async()=>{},interests:{getActiveCompletedSnapshot:async()=>null},exams:{get:async()=>exam,list:async()=>({records:[exam],cursor:undefined,hasMore:false})},saved});
+  return {service,saved,invalidate:()=>{live=false;},expire:()=>{clock+=1800001;}};
+}
+const command = (action:Record<string,unknown>) => readRecommendationCommand({requestId:"r1",sessionGeneration:1,...action})!;
+
+describe("transparent report and historical screening recommendations",()=>{
+  it("gives the two balanced middle cases one priority tier and changes their order only with the selected weight",()=>{
+    const data=dataset(),input=settings();
+    const build=()=>data.programs["115"].map(row=>buildRecommendation(row,input,null,exam,data));
+    let rows=rankRecommendations(build());
+    expect(rows.map(row=>row.item.programRef)).toEqual(["115:001001","115:001002","115:001003","115:001004"]);
+    expect(rows.map(row=>row.item.priorityTier)).toEqual([1,2,2,3]);
