+          if (!current()) return;
+          scope = { generation, uid, service: new RecommendationService({ current, interests: currentRuntime.interests(uid), exams: currentRuntime.exams(uid), saved: new RecommendationRepository(currentRuntime.db, uid, () => current() ? uid : null) }) };
+          recommendationScope.current = scope;
+        }
+        await executeRecommendationCommand(command, scope.service, current, emitRecommendation);
+      } catch {
+        emitRecommendation({ channel: "starpath-recommendations", version: 1, requestId: command.requestId, sessionGeneration: generation, type: "error", code: "unavailable", message: "推薦服務暫時無法載入，請稍後重試。" });
+      } finally { recommendationPending.current--; }
