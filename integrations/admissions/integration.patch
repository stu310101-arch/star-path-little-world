diff --git a/lib/recommendationEngine.ts b/lib/recommendationEngine.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6ff24e882c171fc9c2d4728e044632cfd20007f1
--- /dev/null
+++ b/lib/recommendationEngine.ts
@@ -0,0 +1,111 @@
+import { evaluateAcademicCriteria, evaluateProgram, supportsAcademicPartialEvaluation, supportsProgramEvaluation } from "./admission";
+import type { EvaluationResult, Program } from "./types";
+import type { ExamRecord } from "./examRecords";
+import type { InterestProfile } from "./interestRecords";
+import type { RecommendationDataset, RecommendationMapping } from "./recommendationData";
+import { type FavoriteState, type RecommendationItem, type RecommendationSettings, type RecommendationStatus } from "./recommendationTypes";
+
+export type FitEvidence = { groupId: string; category: string; level: 1 | 2; z: string };
+export type RankedRecommendation = { item: RecommendationItem; points: number | null; evidence: FitEvidence[]; evaluation: EvaluationResult | null; mapping: RecommendationMapping | null; program: Program };
+export const normalizeMajor = (value: string) => value.normalize("NFKC").replace(/\s/gu, "").replace(/學類$/u, "");
+export function canonicalMajor(value: string, dataset: RecommendationDataset): string {
+  const normalized = normalizeMajor(value);
+  return dataset.aliases[normalized] ?? normalized;
+}
+export function selectedFits(settings: RecommendationSettings, report: InterestProfile | null, dataset: RecommendationDataset): FitEvidence[] {
+  const rows: FitEvidence[] = settings.source === "manual" ? settings.manual.map(row => ({ ...row, z: "" })) : report ? [
+    ...report.bestFits.map(row => ({ ...row, level: 2 as const })), ...report.suitableFits.map(row => ({ ...row, level: 1 as const })),
+  ] : [];
+  const distinct = new Map<string, FitEvidence>();
+  for (const row of rows) {
+    const clean = { ...row, category: canonicalMajor(row.category, dataset) }, key = `${clean.groupId}|${clean.category}`;
+    if (!distinct.has(key) || distinct.get(key)!.level < clean.level) distinct.set(key, clean);
+  }
+  return [...distinct.values()];
+}
+export function recommendationPoints(level: 1 | 2, status: "passed" | "failed", mode: RecommendationSettings["mode"]): number {
+  const [interest, academic] = mode === "interest" ? [7, 3] : mode === "academic" ? [3, 7] : [5, 5];
+  return interest * level + academic * (status === "passed" ? 2 : 1);
+}
+export function academicState(program: Program, exam: ExamRecord | null, gender: RecommendationSettings["applicantGender"]) {
+  if (!exam) return { status: "explore" as const, label: "尚未選擇成績・興趣探索", missing: [] as string[], evaluation: null };
+  const chosenGender = gender || undefined;
+  const supported = supportsProgramEvaluation(program, chosenGender) && program.dataStatus !== "needs-review";
+  const partial = supportsAcademicPartialEvaluation(program, chosenGender);
+  if (!supported && !partial) return { status: "pending" as const, label: "官方條件尚待確認", missing: (program.screeningVariants?.length && !gender) ? ["官方招生性別組別"] : [], evaluation: null };
+  const result = supported ? evaluateProgram(program, exam.scores, chosenGender, exam.apcsScores) : evaluateAcademicCriteria(program, exam.scores, chosenGender, exam.apcsScores);
+  const missing = [...result.missingSubjects, ...(result.apcsEvaluation?.missingParts ?? []).map(part => part === "concept" ? "APCS 觀念" : "APCS 實作")];
+  const special = (program.reviewReasons ?? []).some(reason => reason.startsWith("需特殊檢定") && !reason.includes("APCS"));
+  if (missing.length) return { status: "pending" as const, label: "尚缺必要成績", missing, evaluation: result };
+  if (!supported || special || result.apcsEvaluation?.complete === false || program.officialThresholdStatus === "dash") return { status: "pending" as const, label: "部分條件可試算・其餘待確認", missing, evaluation: result };
+  return { status: result.passed ? "passed" as const : "failed" as const, label: result.passed ? "歷史一階門檻達標" : "已填成績未達歷史門檻", missing, evaluation: result };
+}
+function boostSummary(evaluation: EvaluationResult | null): string {
+  if (!evaluation) return "";
+  const parts: string[] = [];
+  const plan = evaluation.nearestBoost[0];
+  if (plan) {
+    const changes = plan.changes.map(change => change.subject === "英聽" ? `英聽 ${["F", "C", "B", "A"][change.from]}→${["F", "C", "B", "A"][change.to]}` : `${change.subject} +${change.points}`);
+    parts.push(changes.join("、"));
+  }
+  if (evaluation.apcsEvaluation?.failedRules.length) parts.push(...evaluation.apcsEvaluation.failedRules.map(rule => `${rule.label}差 ${rule.deficit} 級`));
+  return parts.join("；");
+}
+export function buildRecommendation(program: Program, settings: RecommendationSettings, report: InterestProfile | null, exam: ExamRecord | null,
+  dataset: RecommendationDataset, favorite?: FavoriteState): RankedRecommendation {
+  const programRef = `${program.year}:${program.programCode}`, mapping = dataset.mappings[programRef] ?? null;
+  const fits = selectedFits(settings, report, dataset);
+  const evidence = mapping?.reliable ? fits.filter(fit => mapping.pairs.some(pair => pair.groupId === fit.groupId && pair.category === fit.category)) : [];
+  const level = evidence.reduce<0 | 1 | 2>((best, row) => Math.max(best, row.level) as 0 | 1 | 2, 0);
+  const extension = !level && !!mapping?.groupIds.some(group => fits.some(row => row.groupId === group));
+  const academic = academicState(program, exam, settings.applicantGender);
+  const status: RecommendationStatus = extension ? "extension" : academic.status;
+  const reasons = evidence.slice(0, 4).map(row => `${settings.source === "manual" ? row.level === 2 ? "優先探索" : "也想探索" : row.level === 2 ? "報告最適合" : "報告適合"}：${row.category}`);
+  if (extension) reasons.push("同學群的延伸探索，未確認為報告學類的精確匹配。");
+  if (!level && !extension) reasons.push("此校系目前未命中選用的興趣方向。");
+  const points = level && !extension && (academic.status === "passed" || academic.status === "failed") ? recommendationPoints(level, academic.status, settings.mode) : null;
+  return { item: { programRef, year: String(program.year), programCode: program.programCode, schoolId: program.schoolId, schoolName: program.schoolName,
+    programName: program.programName, universityId: dataset.schools[`${program.year}:${program.schoolId}`]?.universityId ?? "", groupIds: mapping?.groupIds ?? [], categories: mapping?.categories ?? [],
+    matchLevel: level, matchKind: level ? "exact" : extension ? "extension" : "none", status, statusLabel: extension ? "同學群延伸・非精確匹配" : academic.label,
+    priorityTier: null, reasons, missing: academic.missing, gapSummary: academic.missing.length ? "" : boostSummary(academic.evaluation), favorite: favorite?.value ?? false, favoriteRevision: favorite?.revision ?? 0 },
+    points, evidence, evaluation: academic.evaluation, mapping, program };
+}
+export function rankRecommendations(rows: RankedRecommendation[]): RankedRecommendation[] {
+  const levels = [...new Set(rows.flatMap(row => row.points === null ? [] : [row.points]))].sort((a,b) => b-a);
+  for (const row of rows) row.item.priorityTier = row.points === null ? null : levels.indexOf(row.points) + 1;
+  const group = (row: RankedRecommendation) => row.points !== null ? 0 : row.item.status === "pending" ? 1 : row.item.status === "explore" ? 2 : 3;
+  return rows.sort((a,b) => group(a)-group(b) || (b.points ?? 0)-(a.points ?? 0) ||
+    (a.points === null && b.points === null && a.item.status !== "extension" ? b.item.matchLevel-a.item.matchLevel : 0) ||
+    a.item.programRef.localeCompare(b.item.programRef));
+}
+export function filterRecommendation(row: RankedRecommendation, settings: RecommendationSettings, dataset: RecommendationDataset): boolean {
+  const { keyword, category, status } = settings.filters;
+  if (row.item.matchKind === "none") return false;
+  // Extension results have an explicit tab, never blend into the precise recommendation list.
+  if (status === "all" ? row.item.status === "extension" : row.item.status !== status) return false;
+  if (category && !row.item.categories.includes(canonicalMajor(category, dataset))) return false;
+  const query = keyword.normalize("NFKC").replace(/\s/gu, "").toLocaleLowerCase("zh-Hant");
+  return !query || [row.item.schoolName, row.item.programName, row.item.programCode].some(value => value.normalize("NFKC").replace(/\s/gu, "").toLocaleLowerCase("zh-Hant").includes(query));
+}
+export function recommendationDetails(row: RankedRecommendation, settings: RecommendationSettings, report: InterestProfile | null, exam: ExamRecord | null, dataset: RecommendationDataset) {
+  const { program, evaluation, mapping } = row;
+  const rules = evaluation ? [
+    ...evaluation.ruleResults.map(result => {
+      const missing = result.rule.subjects.filter(subject => exam?.scores[subject] === undefined);
+      return { label: result.rule.label, actual: missing.length ? `尚缺${missing.join("、")}` : result.userScore, required: result.minScore, passed: missing.length ? null : result.passed };
+    }),
+    ...evaluation.requirementGroupResults.flatMap(group => group.mode === "any" ? [{ label: `${group.results.map(result => result.requirement.subject).join("／")}擇一檢定`, actual: group.results.map(result=>`${result.requirement.subject} ${exam?.scores[result.requirement.subject] === undefined ? "未填" : result.userScore}`).join("、"), required: group.results.map(result=>`${result.requirement.subject} ${result.minScore}`).join(" 或 "), passed: group.passed ? true : group.results.some(result=>exam?.scores[result.requirement.subject]===undefined) ? null : false }] : group.results.map(result => ({ label: `${result.requirement.subject}${result.requirement.standard}檢定`, actual: exam?.scores[result.requirement.subject] === undefined ? "未填" : result.userScore as number|string, required: result.minScore as number|string, passed: exam?.scores[result.requirement.subject] === undefined ? null : result.passed }))),
+    ...(evaluation.apcsEvaluation?.ruleResults ?? []).map(result=>({label:result.label,actual:result.userScore,required:result.minScore,passed:result.passed})),
+  ] : [];
+  const history = (["113", "114", "115"] as const).map(year => {
+    const matched = dataset.programs[year].filter(candidate => candidate.schoolId === program.schoolId && candidate.programName === program.programName);
+    if (matched.length !== 1) return { year, programRef: null, status: "unmapped", label: "此年度沒有明確同名校系對應" };
+    const state = academicState(matched[0], exam, settings.applicantGender);
+    return { year, programRef: `${year}:${matched[0].programCode}`, status: state.status, label: state.label };
+  });
+  const sources = [ { label: "官方一階門檻", url: program.source.reportHtmlUrl }, ...(program.source.programDetailUrl ? [{ label: "官方校系簡章", url: program.source.programDetailUrl }] : []), ...(mapping?.sourceUrl ? [{ label: "學群學類來源", url: mapping.sourceUrl }] : []) ];
+  return { matchReasons: row.item.reasons, academicStatus: academicState(program, exam, settings.applicantGender).label, missing: row.item.missing, rules,
+    boostPlans: (row.item.missing.length ? [] : evaluation?.nearestBoost ?? []).map(plan => ({ summary: plan.changes.map(change=>change.subject === "英聽" ? `英聽 ${["F","C","B","A"][change.from]}→${["F","C","B","A"][change.to]}` : `${change.subject} ${change.from}→${change.to}`).join("、"), changes: plan.changes.map(({subject,from,to})=>({subject,from,to})) })),
+    sources, history, reportSummary: report ? { riasec: report.riasec, knowledge: report.knowledge } : null, fitEvidence: row.evidence,
+    mappingNote: mapping ? `${mapping.reliable ? "本校系官方學類對應" : "僅供同學群延伸探索，尚無精確學類對應"}；分類來源 ${mapping.sourceYear} 學年度。` : "尚無明確學類對應。" };
+}
diff --git a/lib/recommendationProtocol.ts b/lib/recommendationProtocol.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4698f3c09ad73d548657b42ce1bd971251cff5a6
--- /dev/null
+++ b/lib/recommendationProtocol.ts
@@ -0,0 +1,39 @@
+import { recExact, recId, recObject, recRevision, recText, recommendationBytes, RECOMMENDATION_CHANNEL, RECOMMENDATION_MAX_BYTES, validateRecommendationSettings, validProgramRef, type RecommendationSettings } from "./recommendationTypes";
+import type { RecommendationService } from "./recommendationService";
+export type RecommendationCommand = { requestId: string; sessionGeneration: number } & (
+  { action: "bootstrap" } | { action: "listExams" | "listFavorites"; cursor: string | null } |
+  { action: "query"; settings: RecommendationSettings } | { action: "page"; queryId: string; cursor: string } |
+  { action: "detail"; queryId: string; programRef: string } | { action: "saveSettings"; settings: RecommendationSettings; expectedRevision: number } |
+  { action: "setFavorite"; programRef: string; value: boolean; expectedRevision: number });
+export function readRecommendationCommand(input: unknown): RecommendationCommand | null {
+  try {
+    if (typeof input === "string") { if (new TextEncoder().encode(input).length > RECOMMENDATION_MAX_BYTES) return null; input = JSON.parse(input); }
+    if (!recObject(input) || recommendationBytes(input) > RECOMMENDATION_MAX_BYTES || !recId(input.requestId) || !recRevision(input.sessionGeneration)) return null;
+    const base = { requestId: input.requestId, sessionGeneration: input.sessionGeneration }, keys = ["requestId", "sessionGeneration", "action"];
+    if (input.action === "bootstrap" && recExact(input, keys)) return { ...base, action: "bootstrap" };
+    if ((input.action === "listExams" || input.action === "listFavorites") && recExact(input,[...keys,"cursor"]) && (input.cursor === null || recId(input.cursor))) return { ...base, action: input.action, cursor: input.cursor };
+    if (input.action === "query" && recExact(input,[...keys,"settings"])) return { ...base, action: "query", settings: validateRecommendationSettings(input.settings) };
+    if (input.action === "page" && recExact(input,[...keys,"queryId","cursor"]) && recId(input.queryId) && recId(input.cursor)) return { ...base, action: "page", queryId: input.queryId, cursor: input.cursor };
+    if (input.action === "detail" && recExact(input,[...keys,"queryId","programRef"]) && recId(input.queryId) && validProgramRef(input.programRef)) return { ...base, action: "detail", queryId: input.queryId, programRef: input.programRef };
+    if (input.action === "saveSettings" && recExact(input,[...keys,"settings","expectedRevision"]) && recRevision(input.expectedRevision)) return { ...base, action: "saveSettings", settings: validateRecommendationSettings(input.settings), expectedRevision: input.expectedRevision };
+    if (input.action === "setFavorite" && recExact(input,[...keys,"programRef","value","expectedRevision"]) && validProgramRef(input.programRef) && typeof input.value === "boolean" && recRevision(input.expectedRevision)) return { ...base, action: "setFavorite", programRef: input.programRef, value: input.value, expectedRevision: input.expectedRevision };
+  } catch { /* Strict ownership-free inputs only. */ }
+  return null;
+}
+export async function executeRecommendationCommand(command: RecommendationCommand, service: RecommendationService, current: () => boolean, emit: (packet: Record<string, unknown>) => void): Promise<void> {
+  const base = { channel: RECOMMENDATION_CHANNEL, version: 1, requestId: command.requestId, sessionGeneration: command.sessionGeneration };
+  try {
+    if (!current()) return;
+    const payload = await service.execute(command);
+    if (!current()) return;
+    const packet = { ...base, ...payload };
+    if (recommendationBytes(packet) > RECOMMENDATION_MAX_BYTES) throw Object.assign(new Error("推薦內容超過訊息容量，請縮小條件後重試。"), { code: "recommendation-too-large" });
+    emit(packet);
+  } catch (error) {
+    if (!current()) return;
+    const known = ["invalid-recommendation-input", "stale-user-session", "cloud-revision-conflict", "mutation-id-conflict", "not-found", "no-active-report", "query-expired", "cursor-expired", "recommendation-too-large"];
+    const code = (error as {code?:string})?.code ?? "unavailable";
+    const message = known.includes(code) && recText((error as Error).message, 500) ? (error as Error).message.slice(0,240) : "推薦資料暫時無法讀取，請確認網路後重試；目前選擇仍保留。";
+    emit({ ...base, type: "error", code: known.includes(code) ? code : "unavailable", message });
+  }
+}
