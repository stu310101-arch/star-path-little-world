new file mode 100644
index 0000000000000000000000000000000000000000..f97cc744c90bb9c5cc1fa064d278297433aeb9ee
--- /dev/null
+++ b/components/SaveExamPanel.tsx
@@ -0,0 +1,44 @@
+"use client";
+import { useMemo, useRef, useState, type FormEvent } from "react";
+import { useAccount } from "./AccountProvider";
+import type { AdmissionQueryState } from "./queryState";
+import { scoresFromDraft, todayDate, validateExamInput, type ExamInput, type ExamKind } from "../lib/examRecords";
+import { friendlyFirebaseError } from "../lib/firebaseClient";
+import { sitePath } from "../config/sitePaths";
+import { currentWorkbench, workbenchUtilityPath } from "../lib/workbench";
+import { lastAdmissionYear } from "../lib/privateSession";
+
+export function SaveExamPanel({ query }: { query: AdmissionQueryState }) {
+  const { user, runtime, error: setupError } = useAccount();
+  const repository = useMemo(() => user && runtime ? runtime.exams(user.uid) : null, [user, runtime]);
+  const [title, setTitle] = useState("");
+  const [kind, setKind] = useState<ExamKind>("mock");
+  const [examDate, setExamDate] = useState(todayDate);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [saved, setSaved] = useState(false);
+  const pendingId = useRef<string | null>(null);
+  async function save(event: FormEvent) {
+    event.preventDefault();
+    if (!repository || busy) return;
+    const input: ExamInput = { schemaVersion: 1, kind, title: title.trim(), examDate, ...scoresFromDraft(query) };
+    try { validateExamInput(input); } catch (reason) { setError((reason as Error).message); return; }
+    setBusy(true); setError(""); setSaved(false);
+    try { pendingId.current ??= repository.newId(); await repository.create(pendingId.current, input); pendingId.current = null; setSaved(true); setTitle(""); }
+    catch (reason) { setError(friendlyFirebaseError(reason)); }
+    finally { setBusy(false); }
+  }
+  return <section className="save-exam-card" aria-labelledby="save-exam-heading">
+    <div><span className="eyebrow">✦ 記錄成長足跡</span><h2 id="save-exam-heading">留下這次成績</h2>
+      <p>模擬考、自行練習都能保留。儲存後，可在 113–115 學年度之間反覆回測。</p></div>
+    {!user || !repository ? <div className="cloud-message"><p>{setupError || "登入後，即可保存、修改與查看歷次成績。"}</p><a className="cloud-primary" href={sitePath(workbenchUtilityPath("/account/", currentWorkbench(), lastAdmissionYear()))}>前往帳號</a></div> :
+      <form onSubmit={save} className="exam-meta-form">
+        <label>考試名稱<input required maxLength={80} placeholder="例如：高三第一次模擬考" value={title} onChange={(event) => { setTitle(event.target.value); setSaved(false); }} /></label>
+        <label>類型<select value={kind} onChange={(event) => setKind(event.target.value as ExamKind)}><option value="mock">模擬考</option><option value="practice">自行練習</option></select></label>
+        <label>考試日期<input required type="date" value={examDate} onChange={(event) => setExamDate(event.target.value)} /></label>
+        <button type="submit" className="cloud-primary" disabled={busy}>{busy ? "儲存中…" : error && pendingId.current ? "重試儲存" : "儲存這次成績"}</button>
+      </form>}
+    {error && <p className="cloud-error" role="alert">{error}</p>}
+    {saved && <p className="cloud-success" role="status">已儲存到你的雲端帳號。<a href={sitePath(workbenchUtilityPath("/scores/", currentWorkbench(), lastAdmissionYear()))}>查看我的成績 →</a></p>}
+  </section>;
+}
