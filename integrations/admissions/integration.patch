new file mode 100644
index 0000000000000000000000000000000000000000..3372ac867fbfd18e836e1c9419dec5aed5fdc632
--- /dev/null
+++ b/tests/shared-account.test.ts
@@ -0,0 +1,34 @@
+import { beforeEach, afterEach, describe, expect, it, vi } from "vitest";
+import type { Auth, User } from "firebase/auth";
+import type { ProfileRepository, AccountProfile } from "../lib/accountProfile";
+const hooks = vi.hoisted(() => ({ auth: (_user: User | null) => {} }));
+vi.mock("firebase/auth", () => ({ onAuthStateChanged: (_auth: Auth, next: (user: User | null) => void) => { hooks.auth = next; return () => {}; } }));
+import { SharedAccount } from "../lib/sharedAccount";
+describe("shared account gate and stale callbacks", () => {
+  beforeEach(() => vi.useFakeTimers()); afterEach(() => vi.useRealTimers());
+  function setup() {
+    const callbacks = new Map<string,(profile:AccountProfile|null,confirmed:boolean)=>void>();
+    const account = new SharedAccount({currentUser:null} as Auth, uid => ({subscribe:(next:(profile:AccountProfile|null,confirmed:boolean)=>void) => {callbacks.set(uid,next);return ()=>{};}} as unknown as ProfileRepository));
+    const login = (uid:string) => hooks.auth({uid} as User);
+    const profile:AccountProfile = {schemaVersion:1,nickname:'小星',identity:'graduate'};
+    return {account,callbacks,login,profile};
+  }
+  it("does not admit a cached profile or an incomplete server profile",()=>{
+    const {account,callbacks,login,profile}=setup(); login('alice');
+    callbacks.get('alice')!(profile,false); expect(account.snapshot().profile).toBeNull(); expect(account.snapshot().profileLoading).toBe(true);
+    callbacks.get('alice')!(null,true); expect(account.snapshot().profile).toBeNull(); expect(account.snapshot().profileLoading).toBe(false);
+    callbacks.get('alice')!(profile,true); expect(account.snapshot().profile).toEqual(profile);
+  });
+  it("switches generation immediately and ignores prior account profile callbacks",()=>{
+    const {account,callbacks,login,profile}=setup(); login('alice'); callbacks.get('alice')!(profile,true);
+    const before=account.snapshot().sessionGeneration; login('bob');
+    expect(account.snapshot().sessionGeneration).toBeGreaterThan(before); expect(account.snapshot().profile).toBeNull();
+    callbacks.get('alice')!(profile,true); expect(account.snapshot().profile).toBeNull();
+    account.invalidate(); callbacks.get('bob')!(profile,true); expect(account.snapshot().user).toBeNull(); expect(account.snapshot().profile).toBeNull();
+  });
+  it("fails closed when cloud identity never becomes confirmed",()=>{
+    const {account,login}=setup(); login('alice'); vi.advanceTimersByTime(15000);
+    expect(account.snapshot().profile).toBeNull(); expect(account.snapshot().profileError).not.toBe('');
+    account.invalidate();
+  });
+});
