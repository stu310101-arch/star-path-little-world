@@ -0,0 +1,76 @@
+"use client";
+
+import { createContext, useContext, useEffect, useState, type ReactNode } from "react";
+import { signOut, type User } from "firebase/auth";
+import { firebaseRuntime, friendlyFirebaseError, type FirebaseRuntime } from "../lib/firebaseClient";
+import { clearPrivateSession, setSessionOwner } from "../lib/privateSession";
+import type { AccountProfile } from "../lib/accountProfile";
+
+type AccountState = { user: User | null; runtime: FirebaseRuntime | null; loading: boolean; error: string;
+  profile: AccountProfile | null; profileLoading: boolean; profileError: string; profileReady: boolean; sessionGeneration: number;
+  saveProfile: (profile: AccountProfile) => Promise<void>;
+  retry: () => void; logout: () => Promise<void> };
+const Context = createContext<AccountState | null>(null);
+
+export function AccountProvider({ children }: { children: ReactNode }) {
+  const [user, setUser] = useState<User | null>(null);
+  const [runtime, setRuntime] = useState<FirebaseRuntime | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+  const [attempt, setAttempt] = useState(0);
+  const [profile, setProfile] = useState<AccountProfile | null>(null);
+  const [profileLoading, setProfileLoading] = useState(false);
+  const [profileError, setProfileError] = useState("");
+  const [sessionGeneration, setSessionGeneration] = useState(0);
+  useEffect(() => {
+    try {
+      if (window.parent !== window && window.parent.location.origin === window.location.origin && window.parent.location.pathname.endsWith("/host/")) {
+        document.body.classList.add("game-embedded");
+      }
+    } catch { /* An unrelated embedding page does not change the presentation. */ }
+    const restore = (event: PageTransitionEvent) => { if (event.persisted) window.location.reload(); };
+    window.addEventListener("pageshow", restore);
+    return () => window.removeEventListener("pageshow", restore);
+  }, []);
+  useEffect(() => {
+    let active = true;
+    let firstResolution = true;
+    let unsubscribe = () => {};
+    firebaseRuntime().then((value) => {
+      if (!active) return;
+      setRuntime(value);
+      unsubscribe = value.account.subscribe((state) => {
+        if (!active) return;
+        const nextUser = state.user;
+        setSessionOwner(nextUser?.uid ?? null, firstResolution);
+        firstResolution = false;
+        setUser(nextUser);
+        setLoading(state.loading);
+        setProfile(state.profile); setProfileLoading(state.profileLoading); setProfileError(state.profileError); setSessionGeneration(state.sessionGeneration);
+        setError("");
+      });
+    }).catch((reason) => {
+      if (active) { setSessionOwner(null, firstResolution); setError(friendlyFirebaseError(reason)); setLoading(false); }
+    });
+    return () => { active = false; unsubscribe(); };
+  }, [attempt]);
+
+  const logout = async () => {
+    if (!runtime) return;
+    runtime.account.invalidate();
+    await runtime.authOperations.signOut(() => signOut(runtime.auth));
+    clearPrivateSession();
+    setSessionOwner(null);
+    setUser(null);
+  };
+  return <Context.Provider value={{ user, runtime, loading, error, logout, profile, profileLoading, profileError,
+    profileReady: !!user && !!profile && !profileLoading && !profileError, sessionGeneration,
+    saveProfile: async (value) => { if (!runtime) throw new Error("帳號服務尚未準備完成。"); await runtime.account.saveProfile(value); },
+    retry: () => { if (runtime) runtime.account.retry(); else { setLoading(true); setError(""); setAttempt((value) => value + 1); } } }}>{children}</Context.Provider>;
+}
+
+export function useAccount() {
+  const value = useContext(Context);
+  if (!value) throw new Error("AccountProvider is required");
+  return value;
+}
