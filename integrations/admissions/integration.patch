+  const input = () => ({ schemaVersion: 1 as const, kind: "mock" as const, title: "第一次模擬考", examDate: "2026-10-19", scores: { 國文: 0, 數A: 15, 英聽: 3 }, apcsScores: { concept: 5 } });
+  const data = () => ({ ...input(), createdAt: serverTimestamp(), updatedAt: serverTimestamp() });
