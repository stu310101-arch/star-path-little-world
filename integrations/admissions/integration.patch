+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { initializeTestEnvironment, assertFails, type RulesTestEnvironment } from "@firebase/rules-unit-testing";
+import { collection, deleteDoc, doc, getDoc, getDocs, limit, query, setDoc, type Firestore } from "firebase/firestore";
+import { RecommendationRepository } from "../lib/recommendationRepository";
+import { InterestRepository } from "../lib/interestRepository";
+import { defaultRecommendationSettings } from "../lib/recommendationTypes";
+import { emptyInterestProfile } from "../lib/interestRecords";
+
+describe.skipIf(!process.env.FIRESTORE_EMULATOR_HOST)("owner-only recommendation settings and favorites (Firestore Emulator)",()=>{
+  let env:RulesTestEnvironment;
+  beforeAll(async()=>{env=await initializeTestEnvironment({projectId:"demo-starpath-recommendations",firestore:{rules:readFileSync(new URL("../firestore.rules",import.meta.url),"utf8"),host:"127.0.0.1",port:8080}});},30000);
+  beforeEach(async()=>{await env.clearFirestore();});
+  afterAll(async()=>{await env?.cleanup();});
+  const db=(uid="alice")=>env.authenticatedContext(uid).firestore() as unknown as Firestore;
+  it("keeps mutation receipts idempotent even after newer writes and detects reused intent IDs",async()=>{
+    const repo=new RecommendationRepository(db(),"alice"),first=defaultRecommendationSettings();
+    expect((await repo.saveSettings(first,0,"first")).settingsRevision).toBe(1);
+    const second={...first,mode:"interest" as const};expect((await repo.saveSettings(second,1,"second")).settingsRevision).toBe(2);
+    expect((await repo.saveSettings(first,0,"first")).settingsRevision).toBe(1);
+    expect((await repo.getSettings()).settings.mode).toBe("interest");
+    await expect(repo.saveSettings(second,0,"first")).rejects.toMatchObject({code:"mutation-id-conflict"});
+    await expect(repo.saveSettings(first,0,"third")).rejects.toMatchObject({code:"cloud-revision-conflict"});
+  },20000);
+  it("persists revisioned favorite removals and never resurrects them on a delayed retry",async()=>{
+    const owner=db(),repo=new RecommendationRepository(owner,"alice"),ref="115:001012";
+    expect(await repo.setFavorite(ref,true,0,"add")).toMatchObject({value:true,revision:1});
+    expect(await repo.setFavorite(ref,false,1,"remove")).toMatchObject({value:false,revision:2});
+    await repo.setFavorite(ref,true,0,"add");expect(await repo.getFavorite(ref)).toMatchObject({value:false,revision:2});
+    await expect(repo.setFavorite(ref,true,1,"stale")).rejects.toMatchObject({code:"cloud-revision-conflict"});
+    await assertFails(deleteDoc(doc(owner,"users/alice/recommendationFavorites/115_001012")));
+  },20000);
+  it("blocks signed-out and other accounts, receipt overwrites and unbounded list queries",async()=>{
+    const owner=db(),repo=new RecommendationRepository(owner,"alice");await repo.saveSettings(defaultRecommendationSettings(),0,"save");await repo.setFavorite("115:001012",true,0,"favorite");
+    for(const other of [db("bob"),env.unauthenticatedContext().firestore() as unknown as Firestore]){
+      for(const path of ["users/alice/recommendationSettings/main","users/alice/recommendationSettings/main/mutations/save","users/alice/recommendationFavorites/115_001012"]){await assertFails(getDoc(doc(other,path)));await assertFails(setDoc(doc(other,path),{stolen:true}));}
+    }
+    await assertFails(getDocs(collection(owner,"users/alice/recommendationFavorites")));
+    await assertFails(getDocs(query(collection(owner,"users/alice/recommendationFavorites"),limit(22))));
+    await assertFails(setDoc(doc(owner,"users/alice/recommendationSettings/main/mutations/save"),{schemaVersion:1,revision:2,payloadHash:"a".repeat(64)}));
+    expect((await repo.listFavoriteStates()).items).toHaveLength(1);
+  },20000);
+  it("guards stale account scopes and validates unsupported settings before writes",async()=>{
+    let uid:string|null="alice";const repo=new RecommendationRepository(db(),"alice",()=>uid);
+    await expect(repo.saveSettings({...defaultRecommendationSettings(),year:"114"},0,"badyear")).rejects.toMatchObject({code:"invalid-recommendation-input"});
+    uid="bob";await expect(repo.setFavorite("115:001012",true,0,"stale")).rejects.toMatchObject({code:"stale-user-session"});
+  },20000);
+  it("captures the selected completed revision/title while a newer draft is being edited",async()=>{
+    const repo=new InterestRepository(db(),"alice"),profile=emptyInterestProfile();profile.title="完成報告";
+    for(const key in profile.riasec)profile.riasec[key]="10";for(const key in profile.knowledge)profile.knowledge[key]="5";
+    profile.bestFits=[{groupId:"information",category:"資訊工程",z:"0.4"}];await repo.complete("one",0,profile,"complete");
+    await repo.saveDraft("one",1,{...profile,title:"新的草稿"},"draft");
+    expect(await repo.getActiveCompletedSnapshot()).toMatchObject({recordId:"one",revision:1,selectionRevision:1,title:"完成報告",profile:{title:"完成報告"}});
