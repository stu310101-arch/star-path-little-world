+const OWNER_KEY = "starpath-session-owner";
+export function lastAdmissionYear(): "113" | "114" | "115" {
+  try { const year = new URLSearchParams(window.location.search).get("year"); if (year === "113" || year === "114" || year === "115") return year; } catch {}
+  try { const year = window.sessionStorage.getItem("starpath-last-year"); if (year === "113" || year === "114") return year; } catch {}
+  return "115";
+}
+export function rememberAdmissionYear(year: "113" | "114" | "115"): void {
+  try { window.sessionStorage.setItem("starpath-last-year", year); } catch {}
+}
+const PRIVATE_QUERY_KEYS = ["query", "ch", "en", "ma", "mb", "so", "na", "li", "ac", "ap", "gender",
+  "filterBy", "group", "academicCategory", "learningGroup", "schoolMode", "schoolGroup", "school", "schoolIds",
+  "naturalMode", "natural", "socialMode", "social", "naturalPending", "socialPending"];
+
+export function sessionOwner(): string | null {
+  try { return window.sessionStorage.getItem(OWNER_KEY); } catch { return null; }
+}
+
+export function clearPrivateSession(preserveIncomingUrl = false): void {
+  if (typeof window === "undefined") return;
+  try {
+    const storage = window.sessionStorage;
+    const keys: string[] = [];
+    for (let index = 0; index < storage.length; index++) {
+      const key = storage.key(index);
+      if (key?.startsWith("admission-") || key?.startsWith("starpath-")) keys.push(key);
+    }
+    keys.forEach((key) => storage.removeItem(key));
+  } catch { /* Restricted browser storage must not block sign-out. */ }
+  if (!preserveIncomingUrl) removePrivateQuery();
+}
+
+export function setSessionOwner(uid: string | null, preserveIncomingUrl = false): void {
+  if (typeof window === "undefined") return;
+  const previous = sessionOwner();
+  if (previous !== uid) clearPrivateSession(preserveIncomingUrl);
+  try {
+    if (uid) window.sessionStorage.setItem(OWNER_KEY, uid);
+    else window.sessionStorage.removeItem(OWNER_KEY);
+  } catch { /* Memory-only UI still works. */ }
+}
+
+export function removePrivateQuery(): void {
+  if (typeof window === "undefined" || !window.history?.replaceState) return;
+  const url = new URL(window.location.href);
+  const old = url.search;
+  PRIVATE_QUERY_KEYS.forEach((key) => url.searchParams.delete(key));
+  if (url.search !== old) window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
+}
