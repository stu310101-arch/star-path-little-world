index 0000000000000000000000000000000000000000..307044920d49cca1efe25500800845ae818b288d
--- /dev/null
+++ b/components/ScoreHistory.tsx
@@ -0,0 +1,106 @@
+"use client";
+import { useEffect, useMemo, useRef, useState, type FormEvent } from "react";
+import { useExamRecords } from "./useExamRecords";
+import { useAccount } from "./AccountProvider";
+import { AccountPanel } from "./AccountPanel";
+import { ScoreForm } from "./ScoreForm";
+import { DEFAULT_QUERY_STATE, EMPTY_APCS_SCORES, EMPTY_SCORES, EXAMPLE_SCORES, restoreQueryState, saveQueryState, type AdmissionQueryState } from "./queryState";
+import { ExamRepository } from "../lib/examRepository";
+import { applyExamToQuery, describeScores, draftFromExam, scoresFromDraft, validateExamInput, type ExamRecord, type ExamKind, type ExamInput } from "../lib/examRecords";
+import { friendlyFirebaseError } from "../lib/firebaseClient";
+import { sitePath } from "../config/sitePaths";
+import { lastAdmissionYear } from "../lib/privateSession";
+import { currentWorkbench, workbenchReturnPath } from "../lib/workbench";
+
+export function ScoreHistory() {
+  const { user, runtime, loading } = useAccount();
+  if (loading) return <p className="cloud-message" role="status">正在開啟你的成績紀錄…</p>;
+  if (!user || !runtime) return <AccountPanel />;
+  return <History key={user.uid} repository={runtime.exams(user.uid)} />;
+}
+
+function History({ repository: initialRepository }: { repository: ExamRepository }) {
+  const { repository, records, setRecords, hasMore, loading, error, setError, load, retry } = useExamRecords(initialRepository);
+  const alive = useRef(true);
+  const [notice, setNotice] = useState("");
+  const [editing, setEditing] = useState<ExamRecord | null>(null);
+  const [deleteId, setDeleteId] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [kindFilter, setKindFilter] = useState<"all" | ExamKind>("all");
+  useEffect(() => { alive.current = true; return () => { alive.current = false; }; }, []);
+  const returnPath = sitePath(workbenchReturnPath(lastAdmissionYear(), currentWorkbench()));
+  const hasAnalysisDesk = currentWorkbench() !== "passport";
+  const visible = useMemo(() => records.filter((record) => kindFilter === "all" || record.kind === kindFilter), [records, kindFilter]);
+  function apply(record: ExamRecord) {
+    const year = lastAdmissionYear();
+    const current = restoreQueryState(year);
+    saveQueryState(applyExamToQuery(current, record), year);
+    window.location.assign(sitePath(workbenchReturnPath(year, currentWorkbench())));
+  }
+  async function remove(record: ExamRecord) {
+    setBusy(true); setError("");
+    try {
+      await repository.remove(record.id);
+      if (!alive.current) return;
+      setRecords((current) => current.filter((item) => item.id !== record.id));
+      setDeleteId(null); setNotice(`已刪除「${record.title}」。`);
+    } catch (reason) { if (alive.current) setError(friendlyFirebaseError(reason)); }
+    finally { if (alive.current) setBusy(false); }
+  }
+  return <section className="score-history">
+    <header className="history-heading"><div><span className="eyebrow">✦ 成長紀錄冊</span><h1>我的成績</h1><p>每一次練習，都是下一步的線索。</p></div>
+      {hasAnalysisDesk && <a className="cloud-primary" href={returnPath}>返回工作台</a>}</header>
+    <div className="history-toolbar"><div className="history-filters" role="group" aria-label="考試類型">{([["all", "全部"], ["mock", "模擬考"], ["practice", "自行練習"]] as const).map(([kind, label]) =>
+      <button type="button" key={kind} aria-pressed={kindFilter === kind} onClick={() => setKindFilter(kind)}>{label}</button>)}</div>
+      <button type="button" disabled={loading} onClick={() => void load()}>重新整理</button></div>
+    {error && <div className="cloud-error" role="alert"><p>{error}</p><button disabled={loading} type="button" onClick={() => void retry()}>重新讀取</button></div>}
+    {notice && <p className="cloud-success" role="status">{notice}</p>}
+    {editing ? <EditExam key={editing.id} record={editing} repository={repository} onCancel={() => setEditing(null)} onSaved={(updated) => {
+      setRecords((current) => current.map((record) => record.id === updated.id ? updated : record)); setEditing(null); setNotice("成績已更新。");
+    }} /> : <div className="history-list">
+      {!loading && !visible.length && !error && <div className="history-empty"><span aria-hidden="true">✧</span><h2>{hasMore ? "已載入的紀錄中沒有這類成績" : records.length ? "還沒有這類成績" : "從第一份成績開始"}</h2><p>{hasMore ? "可繼續載入較早的紀錄，或切換類型。" : "到房間裡的一般大學或 APCS 工作台填入成績，儲存後就會出現在這裡。"}</p>{hasAnalysisDesk && <a href={returnPath}>返回工作台 →</a>}</div>}
+      {visible.map((record) => <article className="exam-record" key={record.id}>
+        <div className="exam-date"><span>{record.examDate.slice(0, 4)}</span><strong>{record.examDate.slice(5).replace("-", "/")}</strong></div>
+        <div className="exam-record-main"><span className={`exam-kind ${record.kind}`}>{record.kind === "mock" ? "模擬考" : "自行練習"}</span><h2>{record.title}</h2><p>{describeScores(record)}</p></div>
+        <div className="exam-record-actions">{hasAnalysisDesk && <button type="button" className="cloud-primary" onClick={() => apply(record)}>帶入回測</button>}
+          <button type="button" onClick={() => { setEditing(record); setError(""); }}>編輯</button><button type="button" className="danger-link" onClick={() => setDeleteId(record.id)}>刪除</button></div>
+        {deleteId === record.id && <div className="delete-confirm" role="alert"><p>確定刪除「{record.title}」？刪除後無法還原。</p><div className="cloud-actions"><button type="button" disabled={busy} className="danger-button" onClick={() => void remove(record)}>{busy ? "刪除中…" : "確認刪除"}</button><button type="button" disabled={busy} onClick={() => setDeleteId(null)}>保留紀錄</button></div></div>}
+      </article>)}
+    </div>}
+    {loading && <p role="status">正在讀取成績…</p>}
+    {hasMore && !editing && <button className="load-more" type="button" disabled={loading} onClick={() => void load(true)}>載入更多紀錄</button>}
+    <p className="history-footnote">英聽與 APCS 會保留各次輸入的快照；未填科目仍維持留白。</p>
+  </section>;
+}
+
+function EditExam({ record, repository, onSaved, onCancel }: { record: ExamRecord; repository: ExamRepository; onSaved: (record: ExamRecord) => void; onCancel: () => void }) {
+  const [query, setQuery] = useState<AdmissionQueryState>({ ...DEFAULT_QUERY_STATE, ...draftFromExam(record) });
+  const [title, setTitle] = useState(record.title);
+  const [examDate, setExamDate] = useState(record.examDate);
+  const [kind, setKind] = useState(record.kind);
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  const alive = useRef(true);
+  useEffect(() => { alive.current = true; return () => { alive.current = false; }; }, []);
+  async function save(event: FormEvent) {
+    event.preventDefault();
+    const input: ExamInput = { schemaVersion: 1, title: title.trim(), examDate, kind, ...scoresFromDraft(query) };
+    try { validateExamInput(input); } catch (reason) { setError((reason as Error).message); return; }
+    setBusy(true); setError("");
+    try { await repository.update(record.id, input); if (alive.current) onSaved({ ...input, id: record.id, updatedAtMillis: Date.now() }); }
+    catch (reason) { if (alive.current) setError(friendlyFirebaseError(reason)); }
+    finally { if (alive.current) setBusy(false); }
+  }
+  return <form className="edit-exam" onSubmit={save}><h2>編輯成績</h2><div className="exam-meta-form">
+    <label>考試名稱<input required maxLength={80} value={title} onChange={(event) => setTitle(event.target.value)} /></label>
+    <label>類型<select value={kind} onChange={(event) => setKind(event.target.value as ExamKind)}><option value="mock">模擬考</option><option value="practice">自行練習</option></select></label>
+    <label>考試日期<input required type="date" value={examDate} onChange={(event) => setExamDate(event.target.value)} /></label></div>
+    <ScoreForm scores={query.scores} apcsScores={query.apcsScores} applicantGender="" showApplicantGender={false} onApplicantGenderChange={() => {}}
+      onChange={(subject, value) => setQuery((current) => ({ ...current, scores: { ...current.scores, [subject]: value } }))}
+      onApcsChange={(part, value) => setQuery((current) => ({ ...current, apcsScores: { ...current.apcsScores, [part]: value } }))}
+      onClear={() => setQuery((current) => ({ ...current, scores: { ...EMPTY_SCORES }, apcsScores: { ...EMPTY_APCS_SCORES } }))}
+      onUseExample={() => setQuery((current) => ({ ...current, scores: { ...EXAMPLE_SCORES }, apcsScores: { ...EMPTY_APCS_SCORES } }))} />
+    {error && <p className="cloud-error" role="alert">{error}</p>}
+    <div className="cloud-actions"><button type="submit" disabled={busy} className="cloud-primary">{busy ? "儲存中…" : error ? "重試儲存" : "儲存變更"}</button><button type="button" disabled={busy} onClick={onCancel}>取消編輯</button></div>
+  </form>;
+}
