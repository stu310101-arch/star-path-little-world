index 0000000000000000000000000000000000000000..be89b1667147f68602daecdafef18488a92760e5
--- /dev/null
+++ b/tests/forum.test.ts
@@ -0,0 +1,73 @@
+import { describe, it, expect } from "vitest";
+import { validateProfile } from "../lib/accountProfile";
+import { publicPreview, readPublicMessage, validateBody } from "../lib/forumRecords";
+import { ForumPager, readForumContext, readForumPageCommand } from "../lib/forumProtocol";
+import { readProgressCommand } from "../lib/progressProtocol";
+import { deviceThreadId, readDeviceId } from "../lib/forumDevices";
+import type { ForumThread, ForumZone } from "../lib/forumRecords";
+describe("public profile and discussion protocol", () => {
+  it("gives each physical device a stable zone-specific address", () => {
+    const ids = new Set<string>();
+    for (const zone of ['university','major','career','high_school','campus'] as ForumZone[]) for (let slot=0;slot<8;slot++) {
+      const id=deviceThreadId(zone,0,slot); ids.add(id); expect(id).toHaveLength(20); expect(readDeviceId(id)).toEqual({zone,page:0,slot});
+      expect(readForumContext({zone,deviceId:id})).toEqual({zone,deviceId:id});
+      expect(readForumContext({zone,deviceId:id,compose:true})).toBeNull();
+    }
+    expect(ids.size).toBe(40);
+    expect(readDeviceId(deviceThreadId('campus',999999,7))).toEqual({zone:'campus',page:999999,slot:7});
+    expect(readDeviceId('SPDEVCL9999999999997')).toBeNull();
+    expect(()=>deviceThreadId('campus',-1,0)).toThrow();
