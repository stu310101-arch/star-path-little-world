+    }
+  }
+
+  function enterGame() {
+    if (!hasGame || $('rules-dialog').open) return;
+    setupActive = false; enteredGame = true;
+    // Older save versions could pause at the pre-confirmation scoring stage.
+    // Bring those to the same automatic result view as new games.
+    if (game.phase === 'scoring') { suggestScoringDead(); game.finish(dead); saveGame(); }
