+            '公用單字資料載入逾時，請確認網路後重試。'
+        ).then(() => {
+            publicDataReady = true;
+        }).catch(error => {
+            publicDataPromise = null;
+            throw error;
+        });
+    }
+    return publicDataPromise;
+}
