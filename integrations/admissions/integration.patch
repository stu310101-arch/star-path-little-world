+        setupAudioSystem();
+        setupBgmAutoplayUnlock();
+        beginAppLoading('正在載入公用單字並確認登入狀態，請稍等。');
+        void ensurePublicDataLoaded().catch(() => {});
+        onAuthStateChanged(auth, user => void handleAuthStateChanged(user), error => {
