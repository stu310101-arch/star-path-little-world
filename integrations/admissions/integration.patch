diff --git a/public/wordking-app/assets/styles.css b/public/wordking-app/assets/styles.css
new file mode 100644
index 0000000000000000000000000000000000000000..a9608d8dab3a0d6cc47ce964146429d37fbdfbad
--- /dev/null
+++ b/public/wordking-app/assets/styles.css
@@ -0,0 +1,141 @@
+#btn-home-brand, #user-controls button { white-space: nowrap; }
+@media (max-width: 639px) {
+    #header-top { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.5rem; }
+    #header-actions { display: contents; }
+    #search-control { min-width: 0; }
+    #search-input, #search-input:focus { width: 100%; min-width: 0; }
+    #user-controls { grid-column: 1 / -1; justify-content: flex-end; flex-wrap: wrap; }
+}
+
+html, body {
+            overflow-x: hidden;
+            width: 100%;
+            -webkit-text-size-adjust: 100%;
+            touch-action: manipulation;
+        }
+
+        /* 單字卡高度固定 */
+        .word-card {
+            perspective: 1000px;
+            cursor: pointer;
+            height: 220px; /* 固定每張單字卡高度 */
+        }
+
+        .word-card-inner {
+            display: grid;
+            grid-template-areas: "card-content";
+            position: relative;
+            width: 100%;
+            height: 100%; /* 內部填滿整個卡片高度 */
+            transition: transform 0.35s ease-out; /* 翻轉動畫縮短、變小一點 */
+            transform-style: preserve-3d;
+            transform-origin: center;
+        }
+
+        .word-card.is-flipped .word-card-inner {
+            transform: rotateY(180deg);
+        }
+
+        .word-card-front,
+        .word-card-back {
+            grid-area: card-content;
+            width: 100%;
+            height: 100%; /* 前後面都跟卡片一樣高 */
+            -webkit-backface-visibility: hidden;
+            backface-visibility: hidden;
+            display: flex;
+            flex-direction: column;
+            align-items: center;
+            border-radius: 1rem;
+            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
+            padding: 1.5rem;
+        }
+
+        .word-card-front {
+            justify-content: center;
+        }
+
+        /* 英文字 + 喇叭圖示：只有正面顯示，點擊時發音 */
+        .word-card-front span[title="發音"]::after {
+            content: '🔊';
+            margin-left: 0.4rem;
+            font-size: 1.6rem;
+        }
+
+        .word-card-back {
+            transform: rotateY(180deg);
+            background-color: #f3f4f6;
+            justify-content: flex-start;      /* 從最上方開始排版 */
+            align-items: stretch;             /* 內容撐滿寬度 */
+            overflow-y: auto;                 /* 超出時用捲動查看其他翻譯 */
+            overflow-x: hidden;
+            -webkit-overflow-scrolling: touch;
+            text-align: center;               /* 中文水平置中 */
+        }
+
+        @keyframes shake {
+            0%, 100% { transform: translateX(0); }
+            25% { transform: translateX(-5px); }
+            75% { transform: translateX(5px); }
+        }
+        .shake { animation: shake 0.2s ease-in-out 0s 2; }
+
+        @keyframes highlight {
+            0% { border-color: #f59e0b; box-shadow: 0 0 15px #f59e0b; transform: scale(1.05); }
+            50% { border-color: #f59e0b; box-shadow: 0 0 25px #f59e0b; transform: scale(1.1); }
+            100% { border-color: #e5e7eb; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); transform: scale(1); }
+        }
+        .highlight-card .word-card-front {
+            animation: highlight 1.5s ease-in-out;
+            border-width: 4px;
+        }
+
+        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
+        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
+        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
+
+        @keyframes woggle {
+            0% { transform: rotate(0deg); }
+            25% { transform: rotate(1deg); }
+            75% { transform: rotate(-1deg); }
+            100% { transform: rotate(0deg); }
+        }
+        .editing-mode .folder-card {
+            animation: woggle 0.3s infinite;
+            border: 2px solid #ef4444;
+        }
+
+        .choice-btn {
+            transition: all 0.2s;
+        }
+        .choice-btn:active {
+            transform: scale(0.98);
+        }
+        .choice-correct {
+            background-color: #22c55e !important;
+            color: white !important;
+            border-color: #22c55e !important;
+        }
+        .choice-wrong {
+            background-color: #ef4444 !important;
+            color: white !important;
+            border-color: #ef4444 !important;
+            opacity: 0.6;
+        }
+
+        #search-suggestions {
+            max-height: 320px;
+            overflow-y: auto;
+            overscroll-behavior: contain;
+            -webkit-overflow-scrolling: touch;
+        }
+
+        .search-suggestion-option {
+            height: 64px;
+            min-height: 64px;
+        }
+
+        .search-suggestion-option[aria-selected="true"] {
+            background-color: #eef2ff;
+            box-shadow: inset 3px 0 0 #4f46e5;
+        }
