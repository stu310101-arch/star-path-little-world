+    $('game-view').hidden = false;
+    // Unhide first so Canvas measures the actual board width. The follow-up
+    // frame also handles a layout/viewport change while configuration was open.
+    render();
+    if (typeof window.requestAnimationFrame === 'function') {
+      window.requestAnimationFrame(() => { if (!setupActive) draw(); });
+    }
+    if (typeof window.scrollTo === 'function') window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
+    $('board-title').focus({ preventScroll: true });
+    scheduleAI();
+  }
+
+  function openRules() {
+    cancelAI(); render(); if (!$('rules-dialog').open) $('rules-dialog').showModal();
+  }
+
+  function syncNewDifficulty() {
+    const config = readSetupConfig();
