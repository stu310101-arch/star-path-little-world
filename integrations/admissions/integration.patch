+        <form onSubmit={submit} className="account-form">
+          {mode === "register" && <><label>公開暱稱<input autoComplete="nickname" required maxLength={40} value={displayName} onChange={(event) => setDisplayName(event.target.value)} /></label>
+            <fieldset className="identity-options"><legend>目前身分</legend>{IDENTITIES.map(value => <label key={value}><input type="radio" name="register-identity" required checked={identity === value} onChange={() => setIdentity(value)} /><span>{IDENTITY_LABELS[value]}</span></label>)}</fieldset></>}
