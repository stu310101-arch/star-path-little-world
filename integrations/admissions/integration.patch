+"use client";
+import { useState } from "react";
+import { useAccount } from "./AccountProvider";
+import { IDENTITIES, IDENTITY_LABELS, isIdentity } from "../lib/accountProfile";
+
+export function ProfileEditor() {
+  const { user, profile, profileLoading, profileError, retry } = useAccount();
+  if (!user) return null;
+  if (profileLoading) return <p role="status">正在讀取你的星途身分…</p>;
+  if (profileError) return <div className="cloud-error" role="alert"><p>{profileError}</p><button type="button" onClick={retry}>重新連線</button></div>;
+  return <ProfileForm key={`${profile?.nickname ?? ""}:${profile?.identity ?? ""}`} />;
+}
+function ProfileForm() {
+  const { user, profile, saveProfile } = useAccount();
+  const [nickname, setNickname] = useState(profile?.nickname ?? user?.displayName?.slice(0, 40) ?? "");
+  const [identity, setIdentity] = useState<string>(profile?.identity ?? "");
+  const [busy, setBusy] = useState(false), [error, setError] = useState(""), [saved, setSaved] = useState(false);
+  if (!user) return null;
+  return <section className="profile-editor" aria-label="星途公開身分"><h2>{profile ? "公開身分" : "完成身分，開始你的星途"}</h2>
+    <p className="muted-copy">此帳號共用於星途各區域。暱稱與身分會顯示在署名留言；選擇匿名時只顯示「匿名」與身分。之後可隨時修改。</p>
+    <form className="account-form" onSubmit={event => { event.preventDefault(); if (busy || !isIdentity(identity)) return; setBusy(true); setError(""); setSaved(false);
+      void saveProfile({ schemaVersion: 1, nickname: nickname.trim(), identity }).then(() => setSaved(true)).catch(reason => setError(reason instanceof Error ? reason.message : "儲存未完成，請重試。")).finally(() => setBusy(false)); }}>
+      <label>公開暱稱<input autoComplete="nickname" required maxLength={40} value={nickname} onChange={event => { setNickname(event.target.value); setSaved(false); }} /></label>
+      <fieldset className="identity-options"><legend>目前身分</legend>{IDENTITIES.map(value => <label key={value}><input type="radio" name="profile-identity" required value={value} checked={identity === value} onChange={() => { setIdentity(value); setSaved(false); }} /><span>{IDENTITY_LABELS[value]}</span></label>)}</fieldset>
+      <button type="submit" className="cloud-primary" disabled={busy || !identity || !nickname.trim()}>{busy ? "儲存中…" : profile ? "儲存身分" : "儲存並完成設定"}</button>
+    </form>{error && <p className="cloud-error" role="alert">{error}</p>}{saved && <p className="cloud-success" role="status">已儲存，共用帳號身分已更新。</p>}
+  </section>;
+}
