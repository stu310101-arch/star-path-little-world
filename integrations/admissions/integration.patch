+      </> : native && !emulatorLogin ? <div className="native-login-card"><p>在系統瀏覽器登入，確認配對碼後回到遊戲。</p>
+        <button className="cloud-primary" onClick={() => window.parent.postMessage({ channel: "starpath-internal", type: "native-login" }, window.location.origin)} type="button">開啟瀏覽器登入</button>
+      </div> : <>
+        {emulatorLogin && <p className="muted-copy" role="status">本機測試帳號：使用電子信箱建立隔離帳號，資料只存於模擬器。</p>}
+        {!emulatorLogin && <button className="google-button" disabled={busy || !runtime} type="button" onClick={() => void run(async () => {
+          if (!runtime) return;
+          const provider = new GoogleAuthProvider(); provider.setCustomParameters({ prompt: "select_account" });
+          await runtime.authOperations.signIn(runtime.authOperations.generation,
+            () => signInWithPopup(runtime.auth, provider), () => signOut(runtime.auth));
+        }, "login")}><span aria-hidden="true">G</span>使用 Google 登入</button>}
+        {googlePopup === "login" && <p className="muted-copy" role="status">請在 Google 彈出視窗完成登入；若要取消，關閉該視窗後即可重試。</p>}
+        <div className="account-divider"><span>或使用電子信箱</span></div>
+        <div className="account-mode" role="group" aria-label="帳號操作">
+          <button type="button" aria-pressed={mode === "login"} onClick={() => { setMode("login"); setError(""); }}>登入</button>
