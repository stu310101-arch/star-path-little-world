+import { describe, expect, it } from "vitest";
+import { INITIAL_HOST_NAVIGATION, navigateHostFrame, observeHostFrame } from "../lib/hostNavigation";
+
+describe("persistent host child navigation", () => {
+  it.each(["general", "apcs"] as const)("keeps %s results and instructions loaded when the child changes year", (desk) => {
+    for (const route of ["query", "results", "how-it-works"]) {
+      for (const native of [false, true]) {
+        const opened = navigateHostFrame(INITIAL_HOST_NAVIGATION, desk, desk, native);
+        let observed = observeHostFrame(opened, `/admissions/115/${route}/`, `?desk=${desk}`, desk);
+        for (const year of ["114", "113", "115"] as const) {
+          observed = observeHostFrame(observed, `/admissions/${year}/${route}/`, `?desk=${desk}`, desk);
+          expect(observed.year).toBe(year);
+          expect(observed.view).toBe(desk);
+          // An unchanged React src prop leaves the child on its results/instructions URL.
+          expect(observed.source).toBe(opened.source);
+          const account = navigateHostFrame(observed, "account", desk, native);
+          expect(account.source).toBe(`/admissions/account/?desk=${desk}&year=${year}${native ? "&embedded=native" : ""}`);
+        }
+      }
+    }
+  });
+  it("observes utility links and history return without overriding the actual child URL", () => {
+    const opened = navigateHostFrame(INITIAL_HOST_NAVIGATION, "apcs", "apcs", true);
+    const account = observeHostFrame(opened, "/admissions/account/", "?desk=apcs&year=114", "apcs");
+    expect(account).toEqual({ ...opened, view: "account", year: "114" });
+    const scores = navigateHostFrame(account, "scores", "apcs", true);
+    const returned = observeHostFrame(scores, "/admissions/114/query/", "?desk=apcs", "apcs");
+    expect(returned).toEqual({ ...scores, view: "apcs" });
+    expect(navigateHostFrame(returned, "apcs", "apcs", true).source).toBe("/admissions/114/query/?desk=apcs&embedded=native");
+  });
+  it("preserves special admissions across years and rejects routes from another desk", () => {
+    const special = navigateHostFrame(INITIAL_HOST_NAVIGATION, "special", "special", false);
+    const older = observeHostFrame(special, "/admissions/113/other-admissions/", "?desk=special", "special");
+    expect(older).toEqual({ ...special, year: "113" });
+    for (const route of ["query", "results", "how-it-works"]) {
+      expect(observeHostFrame(older, `/admissions/114/${route}/`, "?desk=special", "special")).toBe(older);
+    }
+    const general = navigateHostFrame(INITIAL_HOST_NAVIGATION, "general", "general", false);
+    expect(observeHostFrame(general, "/admissions/114/other-admissions/", "?desk=general", "general")).toBe(general);
+    expect(observeHostFrame(general, "/admissions/114/results/", "?desk=apcs", "general")).toBe(general);
+  });
+  it("keeps utility-only passport and unknown documents outside analysis navigation", () => {
+    const passport = navigateHostFrame(INITIAL_HOST_NAVIGATION, "account", null, false);
+    expect(passport.source).toBe("/admissions/account/?desk=passport&year=115");
+    const scores = observeHostFrame(passport, "/admissions/scores/", "?desk=passport&year=114", null);
+    expect(scores).toEqual({ ...passport, view: "scores", year: "114" });
+    for (const path of ["/admissions/114/query/", "/admissions/114/other-admissions/", "/admissions/account/native/", "/other/account/", "blank"]) {
+      expect(observeHostFrame(scores, path, "", null)).toBe(scores);
+    }
+  });
+});
