+import { afterEach, describe, expect, it, vi } from "vitest";
+import { clearPrivateSession, setSessionOwner, lastAdmissionYear } from "../lib/privateSession";
+import { draftFromExam } from "../lib/examRecords";
+import { DEFAULT_QUERY_STATE, restoreQueryState, saveQueryState } from "../components/queryState";
+afterEach(() => vi.unstubAllGlobals());
+function browser() {
+  const entries = new Map<string, string>();
+  const location = { pathname: "/admissions/115/query/", search: "", href: "https://world.example/admissions/115/query/", origin: "https://world.example" };
+  const history = { replaceState: vi.fn((_state, _title, url: string) => {
+    const next = new URL(url, location.origin); location.href = next.href; location.search = next.search;
+  }) };
+  vi.stubGlobal("window", { location, history, sessionStorage: {
+    get length() { return entries.size; }, key: (index: number) => [...entries.keys()][index],
+    getItem: (key: string) => entries.get(key) ?? null, setItem: (key: string, value: string) => entries.set(key, value), removeItem: (key: string) => entries.delete(key),
+  } });
+  return { entries, location, history };
+}
+describe("private score session", () => {
+  it("isolates accounts and removes legacy drafts when logging out or switching user", () => {
+    const { entries } = browser();
+    setSessionOwner("alice");
+    saveQueryState({ ...DEFAULT_QUERY_STATE, scores: { ...DEFAULT_QUERY_STATE.scores, 國文: "12" } });
+    expect(restoreQueryState().scores.國文).toBe("12");
+    entries.set("admission-115-query-v8", "old private draft");
+    setSessionOwner("bob");
+    expect(restoreQueryState().scores.國文).toBe("");
+    expect(entries.has("admission-115-query-v8")).toBe(false);
+    clearPrivateSession(); expect(entries.size).toBe(0);
+  });
+  it("imports a legacy score URL once, saves the draft and removes scores from the address", () => {
+    const { location, history } = browser();
+    location.search = "?ch=0&li=3&ac=5&gender=male";
+    location.href += location.search;
+    const state = restoreQueryState();
+    expect(state.scores.國文).toBe("0");
+    expect(state.scores.英聽).toBe("3");
+    expect(history.replaceState).toHaveBeenCalledWith(null, "", "/admissions/115/query/");
+    expect(restoreQueryState().apcsScores.concept).toBe("5");
+  });
+  it("preserves a legacy URL during first Auth resolution while clearing the previous owner's draft", () => {
+    const { entries, location } = browser();
+    setSessionOwner("old-user");
+    entries.set("admission-unified-115-v1:user:old-user", "private old draft");
+    location.search = "?ch=0&en=13&ac=5"; location.href += location.search;
+    setSessionOwner("new-user", true);
+    expect(entries.has("admission-unified-115-v1:user:old-user")).toBe(false);
+    expect(location.search).toBe("?ch=0&en=13&ac=5");
+    const imported = restoreQueryState();
+    expect(imported.scores.國文).toBe("0"); expect(imported.scores.英文).toBe("13");
+    expect(location.search).toBe("");
+    expect(restoreQueryState().apcsScores.concept).toBe("5");
+  });
+  it("loads a record into the last analysis year without replacing that year's filters", () => {
+    browser(); setSessionOwner("alice");
+    const previous = { ...DEFAULT_QUERY_STATE, applicantGender: "female" as const, schoolGroupIds: ["top"] as typeof DEFAULT_QUERY_STATE.schoolGroupIds };
+    saveQueryState(previous, "114");
+    const year = lastAdmissionYear();
+    expect(year).toBe("114");
+    const draft = draftFromExam({ scores: { 國文: 0, 英文: 12 }, apcsScores: { concept: 5 } });
+    saveQueryState({ ...restoreQueryState(year), ...draft }, year);
+    const restored = restoreQueryState(year);
+    expect(restored.applicantGender).toBe("female");
+    expect(restored.schoolGroupIds).toEqual(["top"]);
+    expect(restored.scores.國文).toBe("0");
+    expect(restored.scores.數A).toBe("");
+    expect(restored.apcsScores.concept).toBe("5");
+  });
+  it("retains the public return year through account hydration while dropping private drafts", () => {
+    const { location } = browser();
+    saveQueryState({ ...DEFAULT_QUERY_STATE, scores: { ...DEFAULT_QUERY_STATE.scores, 國文: "15" } }, "114");
+    location.pathname = "/admissions/account/";
+    location.search = "?year=114&desk=apcs";
+    location.href = location.origin + location.pathname + location.search;
+    setSessionOwner("new-user");
+    expect(lastAdmissionYear()).toBe("114");
+    expect(location.search).toBe("?year=114&desk=apcs");
+    expect(restoreQueryState("114").scores.國文).toBe("");
+  });
+});
