+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { initializeTestEnvironment, assertFails, type RulesTestEnvironment } from "@firebase/rules-unit-testing";
+import { collection, doc, getDoc, getDocs, setDoc, type Firestore } from "firebase/firestore";
+import { WordKingRepository } from "../lib/wordkingRepository";
+import { emptyWordKingState, makeWordKingBackup } from "../lib/wordkingSnapshot";
+import { ProgressRepository } from "../lib/progressRepository";
+import { runInNewContext } from "node:vm";
+
+describe.skipIf(!process.env.FIRESTORE_EMULATOR_HOST)("private game libraries (Firestore Emulator)", () => {
+  let env: RulesTestEnvironment;
+  beforeAll(async () => { env = await initializeTestEnvironment({ projectId: "demo-starpath-progress", firestore: {
+    rules: readFileSync(new URL("../firestore.rules", import.meta.url), "utf8"), host: "127.0.0.1", port: 8080,
+  } }); });
+  beforeEach(async () => { await env.clearFirestore(); });
+  afterAll(async () => { await env?.cleanup(); });
+  const db = (uid = "alice") => env.authenticatedContext(uid).firestore() as unknown as Firestore;
+  it("round-trips complete cross-realm snapshots and rejects stale revisions", async () => {
+    const repo = new WordKingRepository(db(), "alice");
+    const state = { ...emptyWordKingState(), userOverrides: { word: { isWrong: false } }, settings: { padding: "測試🙂".repeat(40000) } };
+    const foreign = runInNewContext(`(${JSON.stringify(state)})`);
+    expect((await repo.load()).revision).toBe(0);
+    await repo.save("main", foreign, 0);
+    expect((await repo.load()).snapshot).toEqual(state);
+    await expect(repo.save("main", state, 0)).rejects.toMatchObject({ code: "cloud-revision-conflict" });
+  });
+  it("imports a backup only once and preserves both main and subsequent imported-library edits", async () => {
+    const repo = new WordKingRepository(db(), "alice"), main = { ...emptyWordKingState(), settings: { own: true } };
+    await repo.save("main", main, 0);
+    const preview = await repo.previewImport(makeWordKingBackup(emptyWordKingState(), "original-owner"));
+    const imported = await repo.importSnapshot(preview); expect(imported.existing).toBe(false);
+    await repo.save(imported.libraryId, { ...emptyWordKingState(), settings: { later: true } }, 1);
+    expect((await repo.importSnapshot(preview)).existing).toBe(true);
+    expect((await repo.load("main")).snapshot).toEqual(main);
+    expect((await repo.load(imported.libraryId)).snapshot.settings).toEqual({ later: true });
+    expect((await repo.list()).length).toBe(2);
+  });
+  it("blocks another account and signed-out users from library roots, chunks and progress", async () => {
+    const owner = db(); await new WordKingRepository(owner, "alice").save("main", emptyWordKingState(), 0);
+    const meta = (await getDoc(doc(owner, "users/alice/wordkingLibraries/main"))).data()!;
+    const progress = new ProgressRepository(owner, "alice"); await progress.setUniversityFavorite("001", true);
+    for (const other of [db("bob"), env.unauthenticatedContext().firestore() as unknown as Firestore]) {
+      for (const path of ["users/alice/wordkingLibraries/main", `users/alice/wordkingLibraries/main/snapshots/${meta.snapshotId}/chunks/0`, "users/alice/gameProgress/university"]) {
+        await assertFails(getDoc(doc(other, path))); await assertFails(setDoc(doc(other, path), { stolen: true }));
+      }
+      await assertFails(getDocs(collection(other, "users/alice/wordkingLibraries")));
+    }
+  });
+  it("clears owner authority immediately and merges university actions without resurrecting removals", async () => {
+    let uid: string | null = "alice"; const repo = new ProgressRepository(db(), "alice", () => uid);
+    await repo.setUniversityFavorite("001", false); await repo.markUniversityExplored("002");
+    await repo.importUniversity({ favorite_ids: ["001", "003"], visited_ids: ["004"] });
+    const progress = await repo.getUniversity(); expect(progress.favorites).toEqual({ "001": false, "003": true }); expect(progress.explored).toEqual(["002", "004"]);
+    uid = "bob"; await expect(repo.getUniversity()).rejects.toMatchObject({ code: "stale-user-session" });
+    await expect(repo.setUniversityFavorite("001", true)).rejects.toMatchObject({ code: "stale-user-session" });
+  });
+  it("Go uses private cloud revisions and explicit old-save import cannot replace an existing game", async () => {
+    const repo = new ProgressRepository(db(), "alice");
+    const save = { version: 1, started: true, game: { size: 9, komi: 6.5, board: Array(81).fill(0), history: [], moveNumber: 0 }, settings: { mode: "local", difficulty: "easy" }, dead: [] };
+    expect(await repo.loadGo()).toEqual({ state: null, revision: 0 }); await repo.importGo(save);
+    expect((await repo.loadGo()).state).toEqual(save);
+    await expect(repo.importGo(save)).rejects.toMatchObject({ code: "cloud-revision-conflict" });
+  });
+});
