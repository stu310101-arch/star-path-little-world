+  });
+  $('board-input').addEventListener('pointermove', event => {
+    if (!hasGame || dialogsOpen() || event.pointerType === 'touch') return;
+    const point = event.target.closest('.point'), next = point ? Number(point.dataset.index) : -1;
+    if (hover !== next) { hover = next; draw(); }
+  });
+  $('board-input').addEventListener('pointerleave', () => { hover = -1; draw(); });
