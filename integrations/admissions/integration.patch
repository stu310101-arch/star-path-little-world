+    selected = next; point.tabIndex = 0;
+    if (point.matches(':focus-visible')) { hover = next; draw(); }
+  });
+  $('board-input').addEventListener('keydown', event => {
+    if (!hasGame || dialogsOpen()) return;
+    const n = game.size, row = Math.floor(selected / n), col = selected % n;
+    let next = selected;
+    if (event.key === 'ArrowLeft') next = row * n + Math.max(0, col - 1);
+    else if (event.key === 'ArrowRight') next = row * n + Math.min(n - 1, col + 1);
+    else if (event.key === 'ArrowUp') next = Math.max(0, row - 1) * n + col;
+    else if (event.key === 'ArrowDown') next = Math.min(n - 1, row + 1) * n + col;
+    else if (event.key === 'Home') next = event.ctrlKey ? 0 : row * n;
+    else if (event.key === 'End') next = event.ctrlKey ? n * n - 1 : row * n + n - 1;
+    else return;
+    event.preventDefault(); points[selected].tabIndex = -1; selected = next;
+    points[selected].tabIndex = 0; points[selected].focus(); hover = next; draw();
+  });
+  $('new-btn').addEventListener('click', openNewGame);
+  $('continue-btn').addEventListener('click', () => { if (setupActive) enterGame(); });
+  $('rules-btn').addEventListener('click', openRules);
+  $('undo-btn').addEventListener('click', undo);
+  $('pass-btn').addEventListener('click', () => makeMove(null));
+  $('difficulty-select').addEventListener('change', event => {
+    if (!hasGame || dialogsOpen()) return;
+    const level = event.target.value;
+    if (!Object.hasOwn(AI_LEVELS, level)) return;
+    cancelAI(); settings.difficulty = level;
+    saveGame(); render(); scheduleAI();
+    toast(`已切換為${AI_LEVELS[level].name} AI，棋局繼續。`);
+  });
+  $('new-form').addEventListener('change', syncNewDifficulty);
+  $('numbers-btn').addEventListener('click', () => {
+    if (!hasGame || dialogsOpen()) return;
+    settings.numbers = !settings.numbers; saveGame(); render();
+  });
+  $('territory-btn').addEventListener('click', () => {
+    if (!hasGame || dialogsOpen() || game.phase !== 'play') return;
+    settings.territory = !settings.territory; saveGame(); render();
+  });
+  $('sound-btn').addEventListener('click', () => { settings.sound = !settings.sound; saveGame(); render(); if (settings.sound) playSound(1, 0); });
+  $('finish-btn').addEventListener('click', () => {
+    if (!hasGame || dialogsOpen() || (game.phase !== 'scoring' && game.phase !== 'finished')) return;
+    cancelAI();
+    if (game.phase === 'finished') { clearAreaAnalysis(); suggestScoringDead(); }
+    game.finish(dead); saveGame(); render(); toast('已根據雙方死子重新計分。');
+  });
+  $('resume-btn').addEventListener('click', () => {
+    if (!hasGame || dialogsOpen() || game.phase === 'play') return;
