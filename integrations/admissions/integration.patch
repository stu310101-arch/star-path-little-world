+  });
+  document.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click', () => $(button.dataset.close).close()));
+  for (const dialog of [$('rules-dialog')]) {
+    dialog.addEventListener('close', scheduleAI);
+    dialog.addEventListener('click', event => {
+      if (event.target !== dialog) return;
+      const box = dialog.getBoundingClientRect();
+      if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
+    });
+  }
+  document.addEventListener('keydown', event => {
+    if (event.ctrlKey || event.metaKey || event.altKey || dialogsOpen() || /INPUT|SELECT|TEXTAREA/.test(event.target.tagName)) return;
+    const key = event.key.toLowerCase();
+    if (!['u', 'p', 'n', '?'].includes(key)) return;
+    event.preventDefault(); if (event.repeat) return;
+    if (key === 'u') undo(); else if (key === 'p') makeMove(null); else if (key === 'n') openNewGame(); else openRules();
+  });
+  window.addEventListener('pagehide', () => {
+    cancelAI(); saveGame();
+    if (workerURL) { URL.revokeObjectURL(workerURL); workerURL = null; }
+  });
+  window.addEventListener('pageshow', () => scheduleAI());
+  loadGame(); buildBoardInputs(); openNewGame(false);
+  if (cloudMode) void connectCloud();
+  if ('ResizeObserver' in window) new ResizeObserver(draw).observe($('board-frame'));
+  else window.addEventListener('resize', draw);
+})();
+
+</script>
+</body>
+</html>
