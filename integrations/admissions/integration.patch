+    if (!command || recommendationPending.current >= 8) {
+      if (interestObject(input) && interestId(input.requestId)) emitRecommendation({ channel: "starpath-recommendations", version: 1, requestId: input.requestId, sessionGeneration: generation, type: "error", code: command ? "unavailable" : "invalid-recommendation-input", message: command ? "推薦資料仍在處理，請稍後重試。" : "推薦條件格式或容量不正確，請重新選擇。" });
+      return;
