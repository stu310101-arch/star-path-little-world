+"use client";
+import { useEffect, useState } from "react";
+import { useAccount } from "./AccountProvider";
+import { AccountPanel } from "./AccountPanel";
+import { nativePost } from "../lib/hostProtocol";
+import { friendlyFirebaseError } from "../lib/firebaseClient";
+
+export function NativeApproval() {
+  const { user, profileReady } = useAccount();
+  const [requestId, setRequestId] = useState("");
+  const [code, setCode] = useState("");
+  const [expiresAt, setExpiresAt] = useState(0);
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [confirmed, setConfirmed] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+  useEffect(() => {
+    const abort = new AbortController();
+    const id = new URLSearchParams(window.location.search).get("requestId") ?? "";
+    if (!/^[A-Za-z0-9_-]{16,128}$/.test(id)) { setError("配對連結不完整，請返回遊戲重新登入。"); return; }
+    setRequestId(id); setError("");
+    fetch(`/api/native-auth/status?requestId=${encodeURIComponent(id)}`, { cache: "no-store", signal: abort.signal })
+      .then(async (response) => {
+        if (!response.ok) throw new Error("配對已過期或失效，請返回遊戲重新登入。");
+        const data = await response.json() as { code?: unknown; expiresAt?: unknown; status?: unknown };
+        if (typeof data.code !== "string") throw new Error("無法讀取配對碼，請再試一次。");
+        setCode(data.code); setExpiresAt(typeof data.expiresAt === "number" ? data.expiresAt : typeof data.expiresAt === "string" ? Date.parse(data.expiresAt) : NaN);
+        if (["confirmed", "consumed"].includes(String(data.status))) setConfirmed(true);
+        if (["expired", "cancelled"].includes(String(data.status))) throw new Error("配對已過期或取消，請返回遊戲重新登入。");
+      }).catch((reason) => { if (!abort.signal.aborted) setError(reason instanceof TypeError ? "暫時無法連線，請再試一次。" : reason.message); });
+    return () => abort.abort();
+  }, [attempt]);
+  async function confirm() {
+    if (!user || !profileReady || busy || !requestId || !code) return;
+    if (!Number.isFinite(expiresAt) || Date.now() >= expiresAt) { setError("配對已過期，請返回遊戲重新登入。"); return; }
+    setBusy(true); setError("");
+    try {
+      const token = await user.getIdToken();
+      const response = await nativePost("confirm", { requestId, code }, token);
+      if (!response.ok) { setError(response.status === 410 ? "配對已過期，請返回遊戲重新登入。" : "配對未完成，請確認帳號後再試一次。"); return; }
+      setConfirmed(true);
+    } catch (reason) { setError(friendlyFirebaseError(reason)); }
+    finally { setBusy(false); }
+  }
+  return <main className="cloud-page native-approval">
+    <section className="approval-card"><span className="eyebrow">CONNECT TO YOUR WORLD</span><h1>{confirmed ? "已確認連結" : "連結遊戲中的帳號"}</h1>
+      {confirmed ? <p role="status">請回到遊戲，登入會自動完成。你可以關閉這個分頁。</p> : <>
+        <p>確認這組代碼與你目前遊戲畫面中的配對碼相同。</p>
+        {code && <div className="pairing-code" aria-label={`配對碼 ${code}`}>{code}</div>}
+        {user && code && <><p>將以 <strong>{user.email || user.displayName || "目前帳號"}</strong> 登入遊戲。</p>{!profileReady && <p>請先在下方完成公開暱稱與身分設定。</p>}<button type="button" className="cloud-primary" disabled={busy || !!error || !profileReady} onClick={() => void confirm()}>{busy ? "確認中…" : "代碼相同，確認連結"}</button></>}
+        {!user && <p>請先完成下方登入，再確認連結。</p>}
+      </>}
+      {error && <div className="cloud-error" role="alert"><p>{error}</p><button type="button" onClick={() => setAttempt((value) => value + 1)}>重新讀取配對</button></div>}
+    </section>
+    {!confirmed && <AccountPanel compact />}
+  </main>;
+}
