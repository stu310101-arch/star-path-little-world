+++ b/lib/wordkingRepository.ts
@@ -0,0 +1,69 @@
+import { collection, doc, getDocFromServer, getDocsFromServer, onSnapshot, runTransaction, serverTimestamp, type Firestore } from "firebase/firestore";
+import { emptyWordKingState, makeWordKingBackup, previewWordKingImport, validateWordKingState, validPrivateId, type WordKingImport, type WordKingState } from "./wordkingSnapshot";
+
+const conflict = () => Object.assign(new Error("其他裝置已更新這個單字庫，請重新載入後再試。"), { code: "cloud-revision-conflict" });
+export class WordKingRepository {
+  constructor(private db: Firestore, private uid: string, private currentUid: () => string | null = () => uid) {}
+  private guard() { if (!validPrivateId(this.uid) || this.currentUid() !== this.uid) throw Object.assign(new Error("帳號已切換，請重新開啟單字王。"), { code: "stale-user-session" }); }
+  private root(libraryId: string) { if (libraryId !== "main" && !/^import_[a-f0-9]{64}$/.test(libraryId)) throw new Error("單字庫編號無效。"); return doc(this.db, "users", this.uid, "wordkingLibraries", libraryId); }
+  async list() {
+    this.guard(); const rows = await getDocsFromServer(collection(this.db, "users", this.uid, "wordkingLibraries")); this.guard();
+    return [{ id: "main", label: "星途單字庫" }, ...rows.docs.filter(row => row.id !== "main").map(row => ({ id: row.id, label: String(row.data().label || "匯入的單字庫") }))];
+  }
+  async load(libraryId = "main") {
+    this.guard(); const root = this.root(libraryId); const snap = await getDocFromServer(root); this.guard();
+    if (!snap.exists()) {
+      if (libraryId !== "main") throw new Error("找不到這個匯入單字庫，請重新選擇。");
+      return { snapshot: emptyWordKingState(), revision: 0, recovery: null };
+    }
+    const data = snap.data();
+    if (data.schemaVersion !== 1 || !Number.isInteger(data.chunkCount) || data.chunkCount < 1 || data.chunkCount > 128 || !validPrivateId(data.snapshotId)) throw new Error("雲端單字庫格式錯誤。");
+    const parts = await Promise.all(Array.from({ length: data.chunkCount }, (_, index) => getDocFromServer(doc(root, "snapshots", data.snapshotId, "chunks", String(index)))));
+    this.guard(); if (parts.some(part => !part.exists() || typeof part.data()?.json !== "string")) throw new Error("雲端單字庫不完整，請重試載入。");
+    const snapshot = validateWordKingState(JSON.parse(parts.map(part => part.data()!.json).join("")));
+    return { snapshot, revision: data.revision as number, recovery: null };
+  }
+  async save(libraryId: string, input: unknown, expectedRevision: number, createOnly = false, sourceHash?: string) {
+    this.guard(); const snapshot = validateWordKingState(input), root = this.root(libraryId);
+    const serialized = JSON.stringify(snapshot), parts: string[] = [];
+    // Respect code-point boundaries: Firestore would replace a lone UTF-16 surrogate.
+    let part = "";
+    for (const character of serialized) {
+      if (part.length + character.length > 60000) { parts.push(part); part = ""; }
+      part += character;
+    }
+    if (part) parts.push(part);
+    if (parts.length > 128) throw new Error("單字庫過大，尚未更改雲端資料。");
+    const snapshotId = crypto.randomUUID();
+    return runTransaction(this.db, async tx => {
+      this.guard(); const existing = await tx.get(root); this.guard();
+      if (createOnly && existing.exists()) return { revision: existing.data().revision as number, existing: true };
+      const revision = existing.exists() ? Number(existing.data().revision) : 0;
+      if (revision !== expectedRevision) throw conflict();
+      parts.forEach((json, index) => tx.set(doc(root, "snapshots", snapshotId, "chunks", String(index)), { json }));
+      tx.set(root, { schemaVersion: 1, label: libraryId === "main" ? "星途單字庫" : "匯入的原單字王資料", revision: revision + 1,
+        snapshotId, chunkCount: parts.length, ...(sourceHash ? { sourceHash } : {}),
+        ...(!existing.exists() ? { createdAt: serverTimestamp() } : {}), updatedAt: serverTimestamp() }, { merge: true });
+      return { revision: revision + 1, existing: false };
+    });
+  }
+  subscribe(libraryId: string, listener: (revision: number) => void, error?: (error: Error) => void) {
+    this.guard(); return onSnapshot(this.root(libraryId), snap => { if (this.currentUid() === this.uid) listener(snap.exists() ? Number(snap.data().revision) : 0); }, error);
+  }
+  previewImport = previewWordKingImport;
+  async importSnapshot(preview: WordKingImport) {
+    this.guard(); const verified = await previewWordKingImport(preview.backup); this.guard();
+    if (verified.libraryId !== preview.libraryId || verified.sourceHash !== preview.sourceHash) throw new Error("匯入預覽已變更，請重新選擇備份。");
+    const result = await this.save(verified.libraryId, verified.backup.snapshot, 0, true, verified.sourceHash);
+    return { ...result, libraryId: verified.libraryId };
+  }
+  async exportSnapshot(libraryId = "main") { const { snapshot } = await this.load(libraryId); this.guard(); return makeWordKingBackup(snapshot, this.uid); }
+  /** Source UI adapter keeps all SDK calls in this host realm. */
+  forApp(libraryId = "main") {
+    return { load: (_user: unknown, options?: { assertCurrent?: () => void }) => { options?.assertCurrent?.(); return this.load(libraryId); },
+      save: (_previous: WordKingState, next: WordKingState, _user: unknown, options: { expectedRevision: number; assertCurrent?: () => void }) => {
+        options.assertCurrent?.(); return this.save(libraryId, next, options.expectedRevision);
+      }, subscribe: (_user: unknown, listener: (revision: number) => void, error?: (reason: Error) => void) => this.subscribe(libraryId, listener, error),
+      exportRecovery: async () => null };
+  }
+}
diff --git a/lib/wordkingSnapshot.ts b/lib/wordkingSnapshot.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fc6450cc50a426821b3dddb0c0514fe156c830aa
--- /dev/null
+++ b/lib/wordkingSnapshot.ts
@@ -0,0 +1,72 @@
+/** Lossless current-state backups. Historical migration/recovery journals are not snapshots. */
+export type Json = null | boolean | number | string | Json[] | { [key: string]: Json };
+export type WordKingState = { userOverrides: Record<string, Record<string, Json>>; customWords: Record<string, Record<string, Json>>;
+  hiddenWordIds: string[]; userFolders: Record<string, Record<string, Json>>; settings: Record<string, Json> };
+export type WordKingBackup = { format: "wordking-current-snapshot"; version: 1; schemaVersion: 6; complete: true;
+  source: { app: string; uid: string; exportedAt: string }; snapshot: WordKingState };
+export type WordKingImport = { libraryId: string; sourceHash: string; backup: WordKingBackup;
+  counts: { overrides: number; customWords: number; hiddenWords: number; folders: number; wrongWords: number } };
+export const MAX_WORDKING_BYTES = 8 * 1024 * 1024;
+export const emptyWordKingState = (): WordKingState => ({ userOverrides: {}, customWords: {}, hiddenWordIds: [], userFolders: {}, settings: {} });
+const fail = (message: string): never => { throw new Error(message); };
+function object(value: unknown): value is Record<string, unknown> { return !!value && typeof value === "object" && !Array.isArray(value); }
+export function validPrivateId(id: unknown): id is string {
+  return typeof id === "string" && !!id && id === id.trim() && !/[\/\u0000-\u001f\u007f]/.test(id) &&
+    ![".", "..", "__proto__", "prototype", "constructor"].includes(id) && new TextEncoder().encode(id).length <= 512;
+}
+function json(value: unknown, depth = 0): Json {
+  if (depth > 24) return fail("備份資料層次過深。");
+  if (value === null || typeof value === "string" || typeof value === "boolean" || (typeof value === "number" && Number.isFinite(value))) return value;
+  if (Array.isArray(value)) return value.map(item => json(item, depth + 1));
+  if (!object(value)) return fail("備份含有無法保存的資料。");
+  return Object.fromEntries(Object.entries(value).map(([key, item]) => {
+    if (["__proto__", "prototype", "constructor"].includes(key)) fail("備份含有無效的欄位名稱。");
+    return [key, json(item, depth + 1)];
+  }));
+}
+export function validateWordKingState(value: unknown): WordKingState {
+  if (!object(value)) return fail("請選擇完整的單字王目前資料備份。");
+  const fields = ["userOverrides", "customWords", "hiddenWordIds", "userFolders", "settings"];
+  if (fields.some(key => !Object.hasOwn(value, key)) || Object.keys(value).some(key => !fields.includes(key))) return fail("備份必須包含全部五種目前資料欄位。");
+  for (const key of ["userOverrides", "customWords", "userFolders"]) {
+    if (!object(value[key])) return fail(`${key} 格式錯誤。`);
+    for (const [id, item] of Object.entries(value[key])) {
+      if (!validPrivateId(id) || !object(item)) return fail(`${key} 含有無效的資料。`);
+      if ("isWrong" in item && typeof item.isWrong !== "boolean") return fail("待複習狀態必須是 true 或 false。");
+      if (key === "customWords" && (typeof item.english !== "string" || !item.english.trim() || !Array.isArray(item.meanings) ||
+          typeof item.isWrong !== "boolean" || !Array.isArray(item.folderIds) || !Array.isArray(item.lessonIds))) return fail("自訂單字資料不完整。");
+    }
+  }
+  if (!Array.isArray(value.hiddenWordIds) || value.hiddenWordIds.some(id => !validPrivateId(id)) || !object(value.settings)) return fail("隱藏單字或設定格式錯誤。");
+  const state = json(value) as WordKingState;
+  if (new TextEncoder().encode(JSON.stringify(state)).length > MAX_WORDKING_BYTES) return fail("此備份超過 8 MiB，尚未匯入或修改資料。");
+  return state;
+}
+export function canonicalJson(value: Json): string {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(",")}]`;
+  if (value && typeof value === "object") return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonicalJson(value[key])}`).join(",")}}`;
+  return JSON.stringify(value);
+}
+export async function previewWordKingImport(raw: unknown): Promise<WordKingImport> {
+  const data = typeof raw === "string" ? JSON.parse(raw) : raw;
+  if (!object(data) || data.format !== "wordking-current-snapshot" || data.version !== 1 || data.schemaVersion !== 6 || data.complete !== true ||
+      !object(data.source) || typeof data.source.app !== "string" || !validPrivateId(data.source.uid) || typeof data.source.exportedAt !== "string" ||
+      !Number.isFinite(Date.parse(data.source.exportedAt))) return fail("這不是完整的目前資料備份。舊版「遷移備份」不包含後續變更，不能直接匯入。");
+  const snapshot = validateWordKingState(data.snapshot);
+  const backup: WordKingBackup = { format: "wordking-current-snapshot", version: 1, schemaVersion: 6, complete: true,
+    source: { app: data.source.app, uid: data.source.uid, exportedAt: data.source.exportedAt }, snapshot };
+  // Export time is deliberately excluded: identical source contents produce one separate library.
+  const payload = canonicalJson({ app: backup.source.app, uid: backup.source.uid, snapshot });
+  const hash = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(payload));
+  const sourceHash = Array.from(new Uint8Array(hash), byte => byte.toString(16).padStart(2, "0")).join("");
+  return { libraryId: `import_${sourceHash}`, sourceHash, backup, counts: {
+    overrides: Object.keys(snapshot.userOverrides).length, customWords: Object.keys(snapshot.customWords).length,
+    hiddenWords: snapshot.hiddenWordIds.length, folders: Object.keys(snapshot.userFolders).length,
+    wrongWords: [...Object.values(snapshot.userOverrides), ...Object.values(snapshot.customWords)].filter(word => word.isWrong === true).length,
+  } };
+}
+export function makeWordKingBackup(snapshot: unknown, uid: string): WordKingBackup {
+  if (!validPrivateId(uid)) return fail("請先登入。");
+  return { format: "wordking-current-snapshot", version: 1, schemaVersion: 6, complete: true,
+    source: { app: "starpath-wordking", uid, exportedAt: new Date().toISOString() }, snapshot: validateWordKingState(snapshot) };
+}
diff --git a/lib/workbench.ts b/lib/workbench.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4214187df023a5c99c1b8a300b5378dc28fd1742
--- /dev/null
+++ b/lib/workbench.ts
@@ -0,0 +1,54 @@
+import type { Program } from "./types";
+export type Workbench = "all" | "general" | "apcs" | "special" | "passport";
+export type AnalysisDesk = "general" | "apcs" | "special";
+export function nextAnalysisDesk(current: AnalysisDesk | null, target: string, fromDesk = false): AnalysisDesk | null {
+  if (target === "general" || target === "apcs" || target === "special") return target;
+  if (target === "query") return current ?? "general";
+  return fromDesk ? current : null;
+}
+export function isApcsProgram(program: Program): boolean {
+  return /APCS/iu.test(program.programName) ||
+    (["apcsConceptMin", "apcsPracticeMin", "apcsConceptMultiplier", "apcsPracticeMultiplier"] as const).some((key) => Object.prototype.hasOwnProperty.call(program, key)) ||
+    (program.additionalScreeningRules ?? []).some((rule) => /APCS/iu.test(rule.label));
+}
+export type WorkbenchCounts = Record<"all" | "general" | "apcs", { programCount: number; schoolCount: number }>;
+export function workbenchCounts(programs: readonly Program[]): WorkbenchCounts {
+  const count = (records: readonly Program[]) => ({ programCount: records.length, schoolCount: new Set(records.map((program) => program.schoolId)).size });
+  return { all: count(programs), general: count(programs.filter((program) => !isApcsProgram(program))), apcs: count(programs.filter(isApcsProgram)) };
+}
+export function schoolsForPrograms<T extends { schoolId: string }>(schools: readonly T[], programs: readonly { schoolId: string }[]): T[] {
+  const ids = new Set(programs.map((program) => program.schoolId));
+  return schools.filter((school) => ids.has(school.schoolId));
+}
+export function workbenchHref(path: string, workbench: Workbench): string {
+  return workbench === "all" ? path : `${path}${path.includes("?") ? "&" : "?"}desk=${workbench}`;
+}
+export function workbenchReturnPath(year: "113" | "114" | "115", workbench: Workbench): string {
+  if (workbench === "passport") return workbenchUtilityPath("/account/", workbench, year);
+  return workbenchHref(`/${year}/${workbench === "special" ? "other-admissions" : "query"}/`, workbench);
+}
+export function workbenchUtilityPath(path: "/account/" | "/scores/", workbench: Workbench, year: "113" | "114" | "115"): string {
+  return workbenchHref(`${path}?year=${year}`, workbench);
+}
+export function allowsWorkbenchRoute(workbench: Workbench, route: string): boolean {
+  if (workbench === "passport") return false;
+  return workbench === "all" || (workbench === "special" ? route === "other-admissions" : route !== "other-admissions");
+}
+export function rememberWorkbench(value: Workbench) {
+  try { window.sessionStorage.setItem("starpath-workbench", value); } catch {}
+}
+export function currentWorkbench(): Workbench {
+  if (typeof window === "undefined") return "all";
+  try {
+    const explicit = new URLSearchParams(window.location.search).get("desk");
+    if (explicit === "general" || explicit === "apcs" || explicit === "special" || explicit === "passport") return explicit;
+    if (window.parent !== window && window.parent.location.origin === window.location.origin && window.parent.location.pathname.endsWith("/host/")) {
+      const value = window.sessionStorage.getItem("starpath-workbench");
+      if (value === "general" || value === "apcs" || value === "special" || value === "passport") return value;
+    }
+  } catch {}
+  return "all";
+}
+export function matchesWorkbench(apcs: boolean, workbench: Workbench): boolean {
+  return workbench === "apcs" ? apcs : workbench === "general" ? !apcs : true;
+}
