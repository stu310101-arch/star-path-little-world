new file mode 100644
index 0000000000000000000000000000000000000000..0a3404b8261041e804eb48647d3ca585cc1c76f6
--- /dev/null
+++ b/lib/recommendationTypes.ts
@@ -0,0 +1,54 @@
+import { isLearningGroupId } from "./learningGroupCatalog";
+
+export const RECOMMENDATION_CHANNEL = "starpath-recommendations";
+export const RECOMMENDATION_MAX_BYTES = 65536;
+export const RECOMMENDATION_PAGE_SIZE = 20;
+export const RECOMMENDATION_TTL = 30 * 60 * 1000;
+export const RECOMMENDATION_ALGORITHM = "report-and-screening-v1";
+export type RecommendationYear = "113" | "114" | "115";
+export type RecommendationMode = "balanced" | "interest" | "academic";
+export type RecommendationStatus = "passed" | "failed" | "pending" | "explore" | "extension";
+export type ManualInterest = { groupId: string; category: string; level: 1 | 2 };
+export type RecommendationSettings = {
+  source: "activeReport" | "manual"; manual: ManualInterest[]; examId: string;
+  mode: RecommendationMode; year: RecommendationYear; applicantGender: "" | "male" | "female";
+  filters: { keyword: string; category: string; status: "all" | RecommendationStatus };
+};
+export const defaultRecommendationSettings = (): RecommendationSettings => ({ source: "activeReport", manual: [], examId: "", mode: "balanced", year: "115", applicantGender: "", filters: { keyword: "", category: "", status: "all" } });
+export const recommendationBytes = (value: unknown) => new TextEncoder().encode(JSON.stringify(value)).length;
+export const recObject = (value: unknown): value is Record<string, unknown> => !!value && typeof value === "object" && !Array.isArray(value);
+export const recId = (value: unknown): value is string => typeof value === "string" && /^[A-Za-z0-9_-]{1,64}$/.test(value);
+export const recRevision = (value: unknown): value is number => Number.isSafeInteger(value) && Number(value) >= 0;
+export const recText = (value: unknown, maximum: number): value is string => typeof value === "string" && Array.from(value).length <= maximum && !/[\u0000-\u001f\u007f]/.test(value);
+export const recExact = (value: Record<string, unknown>, keys: string[]) => Object.keys(value).length === keys.length && keys.every(key => Object.hasOwn(value, key));
+export const validProgramRef = (value: unknown): value is string => typeof value === "string" && /^(113|114|115):\d{6}$/.test(value);
+export function recommendationError(code: string, message: string) { return Object.assign(new Error(message), { code }); }
+export function validateRecommendationSettings(input: unknown): RecommendationSettings {
+  const invalid = () => recommendationError("invalid-recommendation-input", "推薦條件格式不正確，請重新選擇。");
+  if (!recObject(input) || !recExact(input, ["source", "manual", "examId", "mode", "year", "applicantGender", "filters"]) ||
+    !["activeReport", "manual"].includes(String(input.source)) || !Array.isArray(input.manual) || input.manual.length > 128 ||
+    !(input.examId === "" || recId(input.examId)) || !["balanced", "interest", "academic"].includes(String(input.mode)) ||
+    input.year !== "115" || !["", "male", "female"].includes(String(input.applicantGender)) ||
+    !recObject(input.filters) || !recExact(input.filters, ["keyword", "category", "status"]) || !recText(input.filters.keyword, 80) ||
+    !recText(input.filters.category, 80) || !["all", "passed", "failed", "pending", "explore", "extension"].includes(String(input.filters.status))) throw invalid();
+  const seen = new Set<string>();
+  const manual = input.manual.map(row => {
+    if (!recObject(row) || !recExact(row, ["groupId", "category", "level"]) || !isLearningGroupId(String(row.groupId)) ||
+      !recText(row.category, 80) || !row.category.trim() || (row.level !== 1 && row.level !== 2)) throw invalid();
+    const key = `${row.groupId}|${row.category.normalize("NFKC").replace(/\s/gu, "").replace(/學類$/u, "")}`;
+    if (seen.has(key)) throw invalid(); seen.add(key);
+    return { groupId: String(row.groupId), category: row.category.trim(), level: row.level } as ManualInterest;
+  });
+  return { source: input.source as RecommendationSettings["source"], manual, examId: input.examId as string, mode: input.mode as RecommendationMode,
+    year: input.year as RecommendationYear, applicantGender: input.applicantGender as RecommendationSettings["applicantGender"],
+    filters: { keyword: input.filters.keyword.trim(), category: input.filters.category.trim(), status: input.filters.status as RecommendationSettings["filters"]["status"] } };
+}
+export type RecommendationItem = {
+  programRef: string; year: string; programCode: string; schoolId: string; schoolName: string; programName: string; universityId: string;
+  groupIds: string[]; categories: string[]; matchLevel: 0 | 1 | 2; matchKind: "exact" | "extension" | "none";
+  status: RecommendationStatus; statusLabel: string; priorityTier: number | null; reasons: string[]; missing: string[];
+  gapSummary: string; favorite: boolean; favoriteRevision: number;
+};
+export type CompletedReportSummary = { recordId: string; revision: number; selectionRevision: number; title: string };
+export type FavoriteState = { programRef: string; value: boolean; revision: number; updatedAtMillis: number };
+export type CatalogItem = { groupId: string; groupLabel: string; category: string };
diff --git a/lib/sharedAccount.ts b/lib/sharedAccount.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4e29e109738fe7bcd129a2c87b1df4c3637a258b
--- /dev/null
+++ b/lib/sharedAccount.ts
@@ -0,0 +1,50 @@
+import { onAuthStateChanged, type Auth, type User } from "firebase/auth";
+import { ProfileRepository, type AccountProfile } from "./accountProfile";
+
+export type SharedAccountState = { user: User | null; profile: AccountProfile | null; loading: boolean; profileLoading: boolean; profileError: string; sessionGeneration: number };
+function nextGeneration(previous: number): number {
+  // Persist only a counter, so retrying the host iframe cannot reuse an old
+  // epoch while the game still has requests from the previous document.
+  let stored = 0;
+  try { stored = Number(window.sessionStorage.getItem("starpath-account-generation")) || 0; } catch {}
+  const generation = Math.max(previous, Date.now(), Number.isSafeInteger(stored) ? stored : 0) + 1;
+  try { window.sessionStorage.setItem("starpath-account-generation", String(generation)); } catch {}
+  return generation;
+}
+/** One account epoch for every same-origin frame. It never leaves the host as a UID. */
+export class SharedAccount {
+  private listeners = new Set<(state: SharedAccountState) => void>();
+  private stopProfile = () => {};
+  private profileTimer: ReturnType<typeof setTimeout> | undefined;
+  private state: SharedAccountState = { user: null, profile: null, loading: true, profileLoading: false, profileError: "", sessionGeneration: 0 };
+  constructor(private auth: Auth, private profiles: (uid: string) => ProfileRepository) {
+    onAuthStateChanged(auth, user => this.resolve(user), () => { this.invalidate(); this.state = { ...this.state, loading: false, profileError: "無法確認登入狀態，請重新連線。" }; this.emit(); });
+  }
+  retry(): void { this.resolve(this.auth.currentUser); }
+  private resolve(user: User | null): void {
+      this.stopProfile(); clearTimeout(this.profileTimer);
+      const generation = nextGeneration(this.state.sessionGeneration);
+      this.state = { user, profile: null, loading: false, profileLoading: !!user, profileError: "", sessionGeneration: generation };
+      this.emit();
+      if (!user) return;
+      const current = () => this.state.sessionGeneration === generation && this.state.user?.uid === user.uid;
+      this.profileTimer = setTimeout(() => { if (current() && this.state.profileLoading) { this.state = { ...this.state, profileLoading: false, profileError: "尚未取得雲端身分資料，請確認網路後重新連線。" }; this.emit(); } }, 15000);
+      this.stopProfile = this.profiles(user.uid).subscribe((profile, confirmed) => {
+        if (!current() || !confirmed) return;
+        clearTimeout(this.profileTimer);
+        this.state = { ...this.state, profile, profileLoading: false, profileError: "" }; this.emit();
+      }, () => { if (current()) { clearTimeout(this.profileTimer); this.state = { ...this.state, profile: null, profileLoading: false, profileError: "無法讀取雲端身分資料，請重新連線後再試。" }; this.emit(); } });
+  }
+  snapshot(): SharedAccountState { return this.state; }
+  subscribe(listener: (state: SharedAccountState) => void): () => void { this.listeners.add(listener); listener(this.state); return () => { this.listeners.delete(listener); }; }
+  private emit() { this.listeners.forEach(listener => listener(this.state)); }
+  invalidate(): void {
+    this.stopProfile(); clearTimeout(this.profileTimer);
+    this.state = { user: null, profile: null, loading: false, profileLoading: false, profileError: "", sessionGeneration: nextGeneration(this.state.sessionGeneration) }; this.emit();
+  }
+  async saveProfile(profile: AccountProfile): Promise<void> {
+    const { user, sessionGeneration } = this.state;
+    if (!user) throw new Error("請先登入。");
+    await this.profiles(user.uid).save(profile, () => { if (this.state.sessionGeneration !== sessionGeneration || this.state.user?.uid !== user.uid) throw new Error("帳號已變更，請重新操作。"); });
+  }
+}
