+  const interestOperations = useRef<Promise<void>>(Promise.resolve());
+  const interestPending = useRef(0);
+  const recommendationScope = useRef<{ generation: number; uid: string; service: RecommendationService } | null>(null);
+  const recommendationOperations = useRef<Promise<void>>(Promise.resolve());
+  const recommendationPending = useRef(0);
+  const recommendationCommand = useCallback((input: unknown) => {
+    const currentRuntime = runtimeRef.current;
+    if (!currentRuntime) return;
+    const command = readRecommendationCommand(input), state = currentRuntime.account.snapshot();
+    const generation = command?.sessionGeneration ?? (interestObject(input) && interestRevision(input.sessionGeneration) ? input.sessionGeneration : -1);
+    const current = () => { const latest = currentRuntime.account.snapshot(); return alive.current && latest.sessionGeneration === generation && latest.user?.uid === state.user?.uid && !!latest.user && !!latest.profile && !latest.profileError && !latest.profileLoading; };
+    if (!state.user || !current()) return;
+    const uid = state.user.uid;
+    const emitRecommendation = (message: Record<string, unknown>) => {
+      if (!current() || recommendationBytes(message) > RECOMMENDATION_MAX_BYTES) return;
+      if (isNativeContainer()) window.ipc?.postMessage(JSON.stringify(message));
+      else if (window.parent !== window) window.parent.postMessage(message, window.location.origin);
