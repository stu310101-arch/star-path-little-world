+import { describe, expect, it } from "vitest";
+import { allowsWorkbenchRoute, isApcsProgram, matchesWorkbench, nextAnalysisDesk, schoolsForPrograms, workbenchCounts, workbenchReturnPath, workbenchUtilityPath } from "../lib/workbench";
+import { programsForYear, sourcesForYear } from "../lib/annualData";
+import { toProgramOptions } from "../lib/programSelection";
+describe("dataset-backed game workbenches", () => {
+  it.each(["113", "114", "115"] as const)("partitions %s programs without losing or inventing any thresholds", (year) => {
+    const programs = programsForYear(year);
+    const options = toProgramOptions(programs);
+    const general = options.filter((option) => matchesWorkbench(!!option.apcsEligible, "general"));
+    const apcs = options.filter((option) => matchesWorkbench(!!option.apcsEligible, "apcs"));
+    expect(apcs.length).toBeGreaterThan(40);
+    expect(general.length + apcs.length).toBe(programs.length);
+    expect(new Set([...general, ...apcs].map((option) => option.programCode)).size).toBe(programs.length);
+    expect(apcs.map((option) => option.programCode)).toEqual(programs.filter(isApcsProgram).map((program) => program.programCode));
+    const counts = workbenchCounts(programs);
+    for (const [desk, options] of [["general", general], ["apcs", apcs]] as const) {
+      const schools = schoolsForPrograms(sourcesForYear(year), options);
+      expect(counts[desk].programCount).toBe(options.length);
+      expect(counts[desk].schoolCount).toBe(schools.length);
+      expect(new Set(schools.map((school) => school.schoolId))).toEqual(new Set(options.map((option) => option.schoolId)));
+      const resultPrograms = programs.filter((program) => matchesWorkbench(isApcsProgram(program), desk));
+      expect(resultPrograms.map((program) => program.programCode)).toEqual(options.map((option) => option.programCode));
+    }
+    expect(programs.some((program) => program.schoolName.includes("中央警察"))).toBe(false);
+  });
+  it("uses explicit APCS fields or official APCS labels, never a computing major alone", () => {
+    const base = { ...programsForYear("115").find((program) => !isApcsProgram(program))!, programName: "資訊工程學系" };
+    expect(isApcsProgram(base)).toBe(false);
+    for (const key of ["apcsConceptMin", "apcsPracticeMin", "apcsConceptMultiplier", "apcsPracticeMultiplier"]) {
+      expect(isApcsProgram({ ...base, [key]: null })).toBe(true);
+    }
+    expect(isApcsProgram({ ...base, programName: "資訊工程學系（APCS組）" })).toBe(true);
+    expect(isApcsProgram({ ...base, additionalScreeningRules: [{ label: "APCS 實作題", minScore: 3, rawText: "APCS 實作題 3" }] })).toBe(true);
+  });
+  it.each(["general", "apcs", "special"] as const)("keeps %s inside its own desk across years and history return", (desk) => {
+    for (const year of ["113", "114", "115"] as const) {
+      expect(workbenchReturnPath(year, desk)).toBe(`/${year}/${desk === "special" ? "other-admissions" : "query"}/?desk=${desk}`);
+      for (const path of ["/scores/", "/account/"] as const) expect(workbenchUtilityPath(path, desk, year)).toBe(`${path}?year=${year}&desk=${desk}`);
+    }
+    for (const route of ["query", "results", "how-it-works", "home", "other-admissions"]) {
+      expect(allowsWorkbenchRoute(desk, route)).toBe(desk === "special" ? route === "other-admissions" : route !== "other-admissions");
+      expect(allowsWorkbenchRoute("all", route)).toBe(true);
+    }
+  });
+  it("keeps a utility-only passport separate from analysis desk utilities", () => {
+    for (const view of ["account", "scores"]) {
+      expect(nextAnalysisDesk(null, view)).toBeNull();
+      expect(nextAnalysisDesk("apcs", view)).toBeNull(); // Walking to the passport is a new station.
+      expect(nextAnalysisDesk("apcs", view, true)).toBe("apcs"); // A utility opened inside that desk can return.
+      expect(nextAnalysisDesk(null, view, true)).toBeNull();
+    }
+    for (const route of ["query", "results", "how-it-works", "other-admissions", "home"]) expect(allowsWorkbenchRoute("passport", route)).toBe(false);
+    expect(workbenchReturnPath("114", "passport")).toBe("/account/?year=114&desk=passport");
+    expect(nextAnalysisDesk(null, "query")).toBe("general");
+    expect(nextAnalysisDesk("special", "query")).toBe("special");
+  });
+});
