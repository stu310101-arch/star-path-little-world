new file mode 100644
index 0000000000000000000000000000000000000000..ddb6327725c0facf5cc794afd7855e352e245396
--- /dev/null
+++ b/lib/recommendationRepository.ts
@@ -0,0 +1,68 @@
+import { collection, doc, documentId, getDocFromServer, getDocsFromServer, limit, orderBy, query, runTransaction, serverTimestamp, startAfter, type Firestore } from "firebase/firestore";
+import { defaultRecommendationSettings, recId, recRevision, recommendationError, validateRecommendationSettings, validProgramRef, type FavoriteState, type RecommendationSettings } from "./recommendationTypes";
+
+async function fingerprint(value: unknown): Promise<string> {
+  const hash = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(value)));
+  return [...new Uint8Array(hash)].map(byte=>byte.toString(16).padStart(2,"0")).join("");
+}
+export class RecommendationRepository {
+  constructor(private db: Firestore, private uid: string, private currentUid: () => string | null = () => uid) {}
+  private guard() { if (!this.uid || this.currentUid() !== this.uid) throw recommendationError("stale-user-session", "帳號已變更，請重新開啟推薦。"); }
+  private settingsRef() { return doc(this.db, "users", this.uid, "recommendationSettings", "main"); }
+  private favoriteRef(programRef: string) { if (!validProgramRef(programRef)) throw recommendationError("invalid-recommendation-input", "校系編號無效。"); return doc(this.db, "users", this.uid, "recommendationFavorites", programRef.replace(":", "_")); }
+  async getSettings() {
+    this.guard(); const snapshot = await getDocFromServer(this.settingsRef()); this.guard();
+    if (!snapshot.exists()) return { settings: defaultRecommendationSettings(), settingsRevision: 0 };
+    const data = snapshot.data();
+    if (data.schemaVersion !== 1 || !recRevision(data.revision) || data.revision < 1) throw recommendationError("invalid-recommendation-input", "保存的推薦版本無法讀取。");
+    return { settings: validateRecommendationSettings(data.settings), settingsRevision: data.revision as number };
+  }
+  private favorite(data: Record<string, unknown> | undefined, programRef: string): FavoriteState {
+    if (!data) return { programRef, value: false, revision: 0, updatedAtMillis: 0 };
+    if (data.schemaVersion !== 1 || data.programRef !== programRef || typeof data.value !== "boolean" || !recRevision(data.revision) || data.revision < 1) throw recommendationError("invalid-recommendation-input", "收藏資料格式無法讀取。");
+    return { programRef, value: data.value, revision: data.revision, updatedAtMillis: (data.updatedAt as {toMillis?:()=>number})?.toMillis?.() ?? 0 };
+  }
+  async getFavorite(programRef: string) { this.guard(); const snapshot = await getDocFromServer(this.favoriteRef(programRef)); this.guard(); return this.favorite(snapshot.data(), programRef); }
+  /** Each storage page is bounded. Tombstones remain visible to revision-aware callers. */
+  async listFavoriteStates(afterId?: string) {
+    this.guard();
+    if (afterId && !/^(113|114|115)_\d{6}$/.test(afterId)) throw recommendationError("invalid-recommendation-input", "收藏分頁無效。");
+    const snapshots = await getDocsFromServer(query(collection(this.db, "users", this.uid, "recommendationFavorites"), orderBy(documentId()), ...(afterId ? [startAfter(afterId)] : []), limit(21)));
+    this.guard(); const page = snapshots.docs.slice(0,20);
+    return { items: page.map(snapshot => this.favorite(snapshot.data(), snapshot.id.replace("_", ":"))), nextId: snapshots.size > 20 ? page.at(-1)!.id : null };
+  }
+  async allFavoriteStates(): Promise<Map<string, FavoriteState>> {
+    const states = new Map<string, FavoriteState>(); let after: string | undefined;
+    do { const page = await this.listFavoriteStates(after); for (const item of page.items) states.set(item.programRef, item); after = page.nextId ?? undefined; } while (after);
+    return states;
+  }
+  async saveSettings(input: unknown, expectedRevision: number, mutationId: string) {
+    const settings = validateRecommendationSettings(input);
+    const revision = await this.mutate(this.settingsRef(), { settings }, expectedRevision, mutationId);
+    return { settings, settingsRevision: revision };
+  }
+  async setFavorite(programRef: string, value: boolean, expectedRevision: number, mutationId: string) {
+    if (typeof value !== "boolean") throw recommendationError("invalid-recommendation-input", "收藏狀態無效。");
+    const revision = await this.mutate(this.favoriteRef(programRef), { programRef, value }, expectedRevision, mutationId);
+    return { programRef, value, revision };
+  }
+  private async mutate(reference: ReturnType<typeof doc>, payload: Record<string, unknown>, expectedRevision: number, mutationId: string): Promise<number> {
+    this.guard(); if (!recRevision(expectedRevision) || !recId(mutationId)) throw recommendationError("invalid-recommendation-input", "保存版本無效。");
+    // Materialize across a WebView/iframe realm and bind retries to their exact intent.
+    const clean = JSON.parse(JSON.stringify(payload)), payloadHash = await fingerprint(clean); this.guard();
+    return runTransaction(this.db, async transaction => {
+      this.guard(); const receiptRef = doc(reference, "mutations", mutationId);
+      const previous = await transaction.get(reference), receipt = await transaction.get(receiptRef); this.guard();
+      if (receipt.exists()) {
+        if (receipt.data().payloadHash !== payloadHash || !recRevision(receipt.data().revision)) throw recommendationError("mutation-id-conflict", "這個重試編號已用於其他內容，請重新保存。");
+        return receipt.data().revision as number;
+      }
+      const revision: unknown = previous.exists() ? previous.data().revision : 0;
+      if (!recRevision(revision) || revision !== expectedRevision) throw recommendationError("cloud-revision-conflict", "其他裝置已更新資料，請重新讀取後再保存；目前選擇仍保留。");
+      const next = revision + 1;
+      transaction.set(reference, { schemaVersion: 1, ...clean, revision: next, lastMutationId: mutationId, updatedAt: serverTimestamp() });
+      transaction.set(receiptRef, { schemaVersion: 1, payloadHash, revision: next, updatedAt: serverTimestamp() });
+      return next;
+    });
+  }
+}
diff --git a/lib/recommendationService.ts b/lib/recommendationService.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bada1bf54efe6bec7bb71f27c9a2e8223497b9e2
--- /dev/null
+++ b/lib/recommendationService.ts
@@ -0,0 +1,151 @@
+import type { QueryDocumentSnapshot } from "firebase/firestore";
+import type { InterestRepository } from "./interestRepository";
+import type { ExamRepository } from "./examRepository";
+import type { RecommendationRepository } from "./recommendationRepository";
+import type { RecommendationCommand } from "./recommendationProtocol";
+import type { RecommendationDataset } from "./recommendationData";
+import type { RankedRecommendation } from "./recommendationEngine";
+import { describeScores, type ExamRecord } from "./examRecords";
+import { recommendationBytes, recommendationError, RECOMMENDATION_ALGORITHM, RECOMMENDATION_PAGE_SIZE, RECOMMENDATION_TTL, type RecommendationSettings } from "./recommendationTypes";
+
+type Report = NonNullable<Awaited<ReturnType<InterestRepository["getActiveCompletedSnapshot"]>>>;
+type Engine = typeof import("./recommendationEngine");
+type Dependencies = { interests: Pick<InterestRepository,"getActiveCompletedSnapshot">; exams: Pick<ExamRepository,"get"|"list">; saved: Pick<RecommendationRepository,"getSettings"|"saveSettings"|"getFavorite"|"listFavoriteStates"|"setFavorite">;
+  current: () => boolean; load?: () => Promise<{ dataset: RecommendationDataset; engine: Engine }>; now?: () => number; yield?: () => Promise<void> };
+const token = () => `rec_${crypto.randomUUID().replaceAll("-","")}`;
+const summary = (report: Report | null) => report ? { recordId: report.recordId, revision: report.revision, selectionRevision: report.selectionRevision, title: report.title } : null;
+const examSummary = (exam: ExamRecord | null) => exam ? { id: exam.id, title: exam.title, examDate: exam.examDate, updatedAtMillis: exam.updatedAtMillis, summary: describeScores(exam) } : null;
+let loaded: Promise<{ dataset: RecommendationDataset; engine: Engine }> | undefined;
+function loadData() { return loaded ??= Promise.all([import("./recommendationData"), import("./recommendationEngine")]).then(([data,engine])=>({dataset:data.recommendationDataset,engine})).catch(error=>{loaded=undefined;throw error;}); }
+
+// The account WebView normally stays hidden. Timer-based yields are throttled
+// there, turning 34 short batches into a query that exceeds the UI deadline.
+// MessageChannel schedules a task without depending on visibility or timers.
+export function yieldRecommendationWork(): Promise<void> {
+  if (typeof MessageChannel === "undefined") return Promise.resolve();
+  return new Promise(resolve => {
+    const channel = new MessageChannel();
+    channel.port1.onmessage = () => {
+      channel.port1.close();
+      channel.port2.close();
+      resolve();
+    };
+    channel.port2.postMessage(null);
+  });
+}
+type Snapshot = { queryId: string; expires: number; settings: RecommendationSettings; report: Report|null; exam: ExamRecord|null; rows: RankedRecommendation[]; allRows: RankedRecommendation[];
+  counts: Record<"passed"|"failed"|"pending"|"explore"|"extension",number>; warnings:string[]; dataVersion:string };
+type Cursor = { kind:"exams"|"favorites"|"results"; value:unknown; expires:number; queryId?:string };
+export class RecommendationService {
+  private snapshot: Snapshot | null = null;
+  private cursors = new Map<string,Cursor>();
+  private serial = 0;
+  private now: () => number;
+  constructor(private dependencies: Dependencies) { this.now = dependencies.now ?? Date.now; }
+  reset() { this.serial++; this.snapshot=null; this.cursors.clear(); }
+  private guard() { if (!this.dependencies.current()) { this.reset(); throw recommendationError("stale-user-session","帳號已變更，請重新開啟推薦。"); } }
+  private async data() { this.guard(); const result = await (this.dependencies.load ?? loadData)(); this.guard(); return result; }
+  private cursor(kind: Cursor["kind"], value: unknown, queryId?:string):string {
+    for(const [key,cursor] of this.cursors) if(cursor.expires<this.now())this.cursors.delete(key);
+    // Bounded session state; expired/evicted cursors give an explicit reload error.
+    if(this.cursors.size>=512)this.cursors.delete(this.cursors.keys().next().value!);
+    const key=token(); this.cursors.set(key,{kind,value,queryId,expires:this.now()+RECOMMENDATION_TTL});return key;
+  }
+  private readCursor(key:string,kind:Cursor["kind"],queryId?:string) {
+    const cursor=this.cursors.get(key);
+    if(!cursor||cursor.kind!==kind||cursor.expires<this.now()||cursor.queryId!==queryId)throw recommendationError("cursor-expired","這份分頁已失效，請重新讀取。");
+    return cursor.value;
+  }
+  private querySnapshot(queryId:string):Snapshot {
+    this.guard();const result=this.snapshot;
+    if(!result||result.queryId!==queryId||result.expires<this.now())throw recommendationError("query-expired","推薦依據已更新或逾時，請重新產生推薦。");
+    return result;
+  }
+  async execute(command:RecommendationCommand):Promise<Record<string,unknown>> {
+    this.guard();
+    switch(command.action){
+      case "bootstrap": {
+        const [{dataset},saved,report]=await Promise.all([this.data(),this.dependencies.saved.getSettings(),this.dependencies.interests.getActiveCompletedSnapshot()]);this.guard();
+        return {type:"bootstrap",...saved,activeReport:summary(report),catalog:dataset.catalog,years:["115"],algorithmVersion:RECOMMENDATION_ALGORITHM,dataVersion:dataset.dataVersion};
+      }
+      case "listExams": {
+        const after=command.cursor?this.readCursor(command.cursor,"exams") as QueryDocumentSnapshot:undefined;
+        const page=await this.dependencies.exams.list(after);this.guard();
+        return {type:"exams",items:page.records.map(exam=>({...examSummary(exam),kind:exam.kind})),nextCursor:page.hasMore&&page.cursor?this.cursor("exams",page.cursor):null};
+      }
+      case "query":return this.query(command.settings);
+      case "page":return this.page(this.querySnapshot(command.queryId),this.readCursor(command.cursor,"results",command.queryId) as number);
+      case "detail": {
+        const snapshot=this.querySnapshot(command.queryId),{dataset,engine}=await this.data();
+        const [year,code]=command.programRef.split(":");
+        const program=dataset.programs[year as keyof typeof dataset.programs]?.find(program=>program.programCode===code);
+        if(!program)throw recommendationError("not-found","這個年度的校系資料不存在。");
+        const favorite=await this.dependencies.saved.getFavorite(command.programRef);this.guard();this.querySnapshot(command.queryId);
+        const row=engine.buildRecommendation(program,snapshot.settings,snapshot.report?.profile??null,snapshot.exam,dataset,favorite);
+        row.item.priorityTier=snapshot.allRows.find(item=>item.item.programRef===command.programRef)?.item.priorityTier??null;
+        return {type:"detail",queryId:snapshot.queryId,item:row.item,details:engine.recommendationDetails(row,snapshot.settings,snapshot.report?.profile??null,snapshot.exam,dataset)};
+      }
+      case "saveSettings": {
+        const {dataset,engine}=await this.data();this.validateManual(command.settings,dataset,engine);
+        const result=await this.dependencies.saved.saveSettings(command.settings,command.expectedRevision,command.requestId);this.guard();
+        return {type:"settings",...result};
+      }
+      case "listFavorites": {
+        const {dataset}=await this.data();
+        const after=command.cursor?this.readCursor(command.cursor,"favorites") as string:undefined;
+        const page=await this.dependencies.saved.listFavoriteStates(after);this.guard();
+        const items=page.items.filter(row=>row.value).map(row=>{
+          const [year,code]=row.programRef.split(":"),program=dataset.programs[year as keyof typeof dataset.programs]?.find(program=>program.programCode===code);
+          return {programRef:row.programRef,revision:row.revision,updatedAtMillis:row.updatedAtMillis,schoolName:program?.schoolName??"原校系資料已變動",programName:program?.programName??row.programRef,universityId:program?dataset.schools[`${year}:${program.schoolId}`]?.universityId??"":""};
+        });
+        return {type:"favorites",items,nextCursor:page.nextId?this.cursor("favorites",page.nextId):null};
+      }
+      case "setFavorite": {
+        const {dataset}=await this.data(),[year,code]=command.programRef.split(":");
+        if(!dataset.programs[year as keyof typeof dataset.programs]?.some(program=>program.programCode===code))throw recommendationError("not-found","這個年度的校系資料不存在。");
+        const result=await this.dependencies.saved.setFavorite(command.programRef,command.value,command.expectedRevision,command.requestId);this.guard();
+        return {type:"favorite",...result};
+      }
+    }
+  }
+  private validateManual(settings:RecommendationSettings,dataset:RecommendationDataset,engine:Engine) {
+    if(settings.source!=="manual")return;
+    for(const fit of settings.manual)if(!dataset.catalog.some(row=>row.groupId===fit.groupId&&row.category===engine.canonicalMajor(fit.category,dataset)))throw recommendationError("invalid-recommendation-input","請從學類清單選擇探索方向。");
+  }
+  private async query(settings:RecommendationSettings) {
+    const serial=++this.serial;this.snapshot=null;
+    for(const [key,value]of this.cursors)if(value.kind==="results")this.cursors.delete(key);
+    const [{dataset,engine},report,exam]=await Promise.all([this.data(),settings.source==="activeReport"?this.dependencies.interests.getActiveCompletedSnapshot():Promise.resolve(null),settings.examId?this.dependencies.exams.get(settings.examId):Promise.resolve(null)]);
+    this.guard();if(serial!==this.serial)throw recommendationError("query-expired","已改用更新的推薦條件。");
+    if(settings.source==="activeReport"&&!report)throw recommendationError("no-active-report","請先在興趣量表選用完成紀錄，或改用自行選擇學類。");
+    if(settings.examId&&!exam)throw recommendationError("not-found","選用的成績已不存在，請重新選擇。");
+    this.validateManual(settings,dataset,engine);
+    const fits=engine.selectedFits(settings,report?.profile??null,dataset),warnings:string[]=[];
+    const unknown=fits.filter(fit=>!dataset.catalog.some(row=>row.groupId===fit.groupId&&row.category===fit.category));
+    if(!fits.length)warnings.push(settings.source === "manual" ? "請先選擇想探索的學類；目前可查看及比較已收藏校系。" : "這份完成報告尚無最適合或適合學類；可改用自行選擇方向。");
+    if(unknown.length)warnings.push(`${unknown.length} 個報告學類尚無明確對應，保留原報告資料，未強行配對。`);
+    if(!exam)warnings.push("尚未選擇成績；目前僅供興趣探索，不提供共同優先層。");
+    const rows:RankedRecommendation[]=[];
+    for(let index=0;index<dataset.programs["115"].length;index++){
+      const row=engine.buildRecommendation(dataset.programs["115"][index],settings,report?.profile??null,exam,dataset);
+      if(row.item.matchKind!=="none")rows.push(row);
+      if(index%64===63){await (this.dependencies.yield?.()??yieldRecommendationWork());this.guard();if(serial!==this.serial)throw recommendationError("query-expired","已改用更新的推薦條件。");}
+    }
+    engine.rankRecommendations(rows);
+    const counts={passed:0,failed:0,pending:0,explore:0,extension:0};for(const row of rows)counts[row.item.status]++;
+    const snapshot:Snapshot={queryId:token(),expires:this.now()+RECOMMENDATION_TTL,settings:JSON.parse(JSON.stringify(settings)),report,exam,rows:rows.filter(row=>engine.filterRecommendation(row,settings,dataset)),allRows:rows,counts,warnings,dataVersion:dataset.dataVersion};
+    this.snapshot=snapshot;return this.page(snapshot,0);
+  }
+  private async page(snapshot:Snapshot,offset:number) {
+    this.querySnapshot(snapshot.queryId);
+    const selected=snapshot.rows.slice(offset,offset+RECOMMENDATION_PAGE_SIZE);
+    const favorites=await Promise.all(selected.map(row=>this.dependencies.saved.getFavorite(row.item.programRef)));this.guard();this.querySnapshot(snapshot.queryId);
+    const items=selected.map((row,index)=>({...row.item,favorite:favorites[index].value,favoriteRevision:favorites[index].revision}));
+    const packet={type:"results",queryId:snapshot.queryId,items,total:snapshot.rows.length,counts:snapshot.counts,
+      inputs:{settings:snapshot.settings,report:summary(snapshot.report),exam:examSummary(snapshot.exam),algorithmVersion:RECOMMENDATION_ALGORITHM,dataVersion:snapshot.dataVersion},warnings:snapshot.warnings};
+    // A page may contain fewer than twenty large multilingual entries; the cursor
+    // advances by the actual emitted count, never truncating or dropping a result.
+    while(items.length>1&&recommendationBytes(packet)>63000)items.pop();
+    return {...packet,nextCursor:offset+items.length<snapshot.rows.length?this.cursor("results",offset+items.length,snapshot.queryId):null};
+  }
+}
