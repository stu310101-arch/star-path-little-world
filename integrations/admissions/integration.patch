+  it("allows a user to create/read/update/delete their own exam, preserving zero and missing subjects", async () => {
+    const db = env.authenticatedContext("alice").firestore();
+    const ref = doc(db, "users/alice/examAttempts/one");
+    await assertSucceeds(setDoc(ref, data()));
+    const record = await assertSucceeds(getDoc(ref));
+    expect(record.data()?.scores).toEqual({ 國文: 0, 數A: 15, 英聽: 3 });
+    await assertSucceeds(updateDoc(ref, { title: "訂正後", updatedAt: serverTimestamp() }));
+    await assertSucceeds(getDocs(query(collection(db, "users/alice/examAttempts"), limit(20))));
+    await assertSucceeds(deleteDoc(ref));
+  });
+  it("blocks unauthenticated and cross-account CRUD, including list", async () => {
+    const owner = env.authenticatedContext("alice").firestore();
+    await setDoc(doc(owner, "users/alice/examAttempts/one"), data());
+    for (const db of [env.unauthenticatedContext().firestore(), env.authenticatedContext("bob").firestore()]) {
+      const ref = doc(db, "users/alice/examAttempts/one");
+      await assertFails(getDoc(ref));
+      await assertFails(getDocs(query(collection(db, "users/alice/examAttempts"), limit(20))));
+      await assertFails(setDoc(doc(db, "users/alice/examAttempts/two"), data()));
+      await assertFails(updateDoc(ref, { title: "stolen", updatedAt: serverTimestamp() }));
+      await assertFails(deleteDoc(ref));
+    }
+  });
+  it.each([
+    { scores: { 國文: 16 } }, { scores: { 英聽: 4 } }, { scores: { 國文: -1 } }, { scores: { 國文: 2.5 } },
+    { scores: { 國文: "12" } }, { scores: { 未知科目: 3 } }, { apcsScores: { concept: 6 } },
+    { apcsScores: { unknown: 2 } }, { scores: {}, apcsScores: {} }, { ownerUid: "alice" },
+    { title: "" }, { title: "   " }, { examDate: "2026-13-99" }, { kind: "aptitude" },
+    { createdAt: Timestamp.fromMillis(1) },
+  ])("rejects invalid record %j", async (patch) => {
+    const db = env.authenticatedContext("alice").firestore();
+    await assertFails(setDoc(doc(db, "users/alice/examAttempts/invalid"), { ...data(), ...patch }));
+  });
+  it("blocks createdAt edits, unexpected update fields, unlimited queries and future counseling data", async () => {
+    const db = env.authenticatedContext("alice").firestore();
+    const ref = doc(db, "users/alice/examAttempts/one");
+    await setDoc(ref, data());
+    await assertFails(updateDoc(ref, { createdAt: Timestamp.fromMillis(1), updatedAt: serverTimestamp() }));
+    await assertFails(updateDoc(ref, { counselor: true, updatedAt: serverTimestamp() }));
+    await assertFails(getDocs(collection(db, "users/alice/examAttempts")));
+    await assertFails(setDoc(doc(db, "users/alice/aptitude/one"), { result: 1 }));
+    await assertFails(getDoc(doc(db, "users/alice/aptitude/one")));
+  });
+  it("repository uses one document on retry and supports list, update and delete", async () => {
+    const repository = new ExamRepository(env.authenticatedContext("alice").firestore() as unknown as Firestore, "alice");
+    const id = repository.newId();
+    await repository.create(id, runInNewContext(`(${JSON.stringify(input())})`));
+    expect((await repository.get(id))?.scores.國文).toBe(0);
+    await repository.create(id, { ...input(), title: "重試" });
+    let page = await repository.list();
+    expect(page.records).toHaveLength(1);
+    expect(page.records[0].title).toBe("重試");
+    await repository.update(id, runInNewContext(`(${JSON.stringify({ ...input(), scores: { 英文: 15 }, apcsScores: {} })})`));
+    page = await repository.list();
+    expect(page.records[0].scores).toEqual({ 英文: 15 });
+    await repository.remove(id);
+    expect(await repository.get(id)).toBeNull();
+    expect((await repository.list()).records).toEqual([]);
+  });
+});
