new file mode 100644
index 0000000000000000000000000000000000000000..891d8812e2cb499385339d834eb96ccc0b2740ea
--- /dev/null
+++ b/tests/auth-operations.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { AuthOperations } from "../lib/authOperations";
+describe("native authentication cancellation", () => {
+  it("makes sign-out win even if Firebase sign-in has already started", async () => {
+    const queue = new AuthOperations();
+    const epoch = queue.invalidate();
+    const events: string[] = [];
+    let finish!: () => void;
+    const pending = new Promise<void>((resolve) => { finish = resolve; });
+    const login = queue.signIn(epoch, async () => { events.push("sign-in-start"); await pending; events.push("signed-in"); }, async () => { events.push("rollback"); });
+    await Promise.resolve();
+    const logout = queue.signOut(async () => { events.push("signed-out"); });
+    finish();
+    expect(await login).toBe(false); await logout;
+    expect(events).toEqual(["sign-in-start", "signed-in", "rollback", "signed-out"]);
+  });
+  it("never submits a token obtained after cancellation and allows the next pairing", async () => {
+    const queue = new AuthOperations();
+    const stale = queue.invalidate();
+    await queue.signOut(async () => {});
+    let calls = 0;
+    expect(await queue.signIn(stale, async () => { calls++; }, async () => {})).toBe(false);
+    const current = queue.invalidate();
+    expect(await queue.signIn(current, async () => { calls++; }, async () => {})).toBe(true);
+    expect(calls).toBe(1);
+  });
+});
diff --git a/tests/exam-records.test.ts b/tests/exam-records.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3b973fdfc64b6393acd2001ec395160425c8e226
--- /dev/null
+++ b/tests/exam-records.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vitest";
+import { DEFAULT_QUERY_STATE } from "../components/queryState";
+import { appendExamPage, applyExamToQuery, scoresFromDraft, draftFromExam, validateExamInput, type ExamInput, type ExamRecord } from "../lib/examRecords";
+describe("exam record conversion", () => {
+  const input = (): ExamInput => ({ schemaVersion: 1, kind: "practice", title: "數學練習", examDate: "2026-10-19", scores: { 數A: 0, 英聽: 0 }, apcsScores: { concept: 0 } });
+  it("round-trips actual zeros while leaving every unanswered subject absent", () => {
+    const record = input();
+    const draft = draftFromExam(record);
+    expect(draft.scores.國文).toBe("");
+    expect(draft.scores.數A).toBe("0");
+    expect(draft.apcsScores.practice).toBe("");
+    expect(scoresFromDraft(draft)).toEqual({ scores: record.scores, apcsScores: record.apcsScores });
+  });
+  it("replaces only saved grades, preserving all current selections and clearing old absent grades", () => {
+    const current = { ...DEFAULT_QUERY_STATE, applicantGender: "female" as const, schoolGroupIds: ["top" as const], customSchoolIds: ["001"],
+      scores: { ...DEFAULT_QUERY_STATE.scores, 國文: "15", 數A: "9" }, apcsScores: { concept: "5", practice: "4" } };
+    const result = applyExamToQuery(current, input());
+    expect(result).toEqual({ ...current, ...draftFromExam(input()) });
+    expect(result.scores.國文).toBe("");
+    expect(result.scores.數A).toBe("0");
+    expect(result.apcsScores.practice).toBe("");
+    expect(result.schoolGroupIds).toBe(current.schoolGroupIds);
+    expect(result.programSelections).toBe(current.programSelections);
+    expect(current.scores.國文).toBe("15");
+  });
+  it("deduplicates retried pages while retaining prior page order and updated snapshots", () => {
+    const record = (id: string, title = id): ExamRecord => ({ ...input(), id, title, updatedAtMillis: 0 });
+    const first = [record("a"), record("b")];
+    const next = appendExamPage(first, [record("b", "updated"), record("c")]);
+    expect(next.map(({ id, title }) => [id, title])).toEqual([["a", "a"], ["b", "updated"], ["c", "c"]]);
+    expect(first[1].title).toBe("b");
+    expect(appendExamPage(next, [record("b", "updated"), record("c")])).toEqual(next);
+  });
+  it("accepts a single subject and rejects empty, invalid and non-integral scores", () => {
+    expect(() => validateExamInput(input())).not.toThrow();
+    for (const scores of [{ 國文: 16 }, { 英聽: 4 }, { 數A: -1 }, { 數B: 3.5 }, { 國文: Number.NaN }, { 新科目: 1 }]) {
+      expect(() => validateExamInput({ ...input(), scores })).toThrow();
+    }
+    expect(() => validateExamInput({ ...input(), ...scoresFromDraft(DEFAULT_QUERY_STATE) })).toThrow();
+  });
+  it("rejects invalid dates, APCS and empty titles", () => {
+    for (const patch of [{ examDate: "2026-02-31" }, { examDate: "10/19" }, { title: "  " }, { apcsScores: { practice: 6 } }]) {
+      expect(() => validateExamInput({ ...input(), ...patch })).toThrow();
+    }
+  });
+});
