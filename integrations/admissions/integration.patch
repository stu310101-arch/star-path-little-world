diff --git a/components/useExamRecords.ts b/components/useExamRecords.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9dd9ea1eb8ba9dafe31a4da867ace901e897b544
--- /dev/null
+++ b/components/useExamRecords.ts
@@ -0,0 +1,43 @@
+"use client";
+import { useCallback, useEffect, useRef, useState } from "react";
+import type { QueryDocumentSnapshot } from "firebase/firestore";
+import type { ExamRepository } from "../lib/examRepository";
+import { appendExamPage, type ExamRecord } from "../lib/examRecords";
+import { friendlyFirebaseError } from "../lib/firebaseClient";
+
+/** Shared server-only pagination for history and the inline picker. Mount per UID. */
+export function useExamRecords(initialRepository: ExamRepository) {
+  const repository = useRef(initialRepository).current;
+  const [records, setRecords] = useState<ExamRecord[]>([]);
+  const [hasMore, setHasMore] = useState(false);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+  const cursor = useRef<QueryDocumentSnapshot>(undefined);
+  const request = useRef(0);
+  const inFlight = useRef(false);
+  const retryAppend = useRef(false);
+  const load = useCallback(async (append = false) => {
+    if (inFlight.current) return;
+    inFlight.current = true;
+    retryAppend.current = append;
+    const currentRequest = ++request.current;
+    setLoading(true); setError("");
+    try {
+      const page = await repository.list(append ? cursor.current : undefined);
+      if (currentRequest !== request.current) return;
+      setRecords((current) => append ? appendExamPage(current, page.records) : page.records);
+      cursor.current = page.cursor;
+      setHasMore(page.hasMore);
+    } catch (reason) {
+      if (currentRequest === request.current) setError(friendlyFirebaseError(reason));
+    } finally {
+      if (currentRequest === request.current) { inFlight.current = false; setLoading(false); }
+    }
+  }, [repository]);
+  useEffect(() => {
+    void load();
+    return () => { request.current++; inFlight.current = false; };
+  }, [load]);
+  return { repository, records, setRecords, hasMore, loading, error, setError, load,
+    retry: () => load(retryAppend.current) };
+}
