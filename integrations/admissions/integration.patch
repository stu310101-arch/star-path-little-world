--- /dev/null
+++ b/public/wordking-app/readonly-export.js
@@ -0,0 +1,38 @@
+/* Run only on the original WordKing page after logging into YOUR own account.
+ * READ ONLY: no persistence.load(), transactions, writes, deletes or auth changes. */
+(async () => {
+  'use strict';
+  if (location.protocol !== 'https:') throw new Error('請在你原本的 HTTPS 單字王網站操作。');
+  const [{ getApps }, { getAuth }, { getFirestore, doc, collection, getDocFromServer, getDocsFromServer }] = await Promise.all([
+    import('https://www.gstatic.com/firebasejs/12.8.0/firebase-app.js'),
+    import('https://www.gstatic.com/firebasejs/12.8.0/firebase-auth.js'),
+    import('https://www.gstatic.com/firebasejs/12.8.0/firebase-firestore.js')
+  ]);
+  const app = getApps().find(app => app.options.projectId === 'wordking-434f7');
+  if (!app) throw new Error('未找到原單字王帳號連線；沒有更改任何資料。');
+  const auth = getAuth(app), user = auth.currentUser;
+  if (!user) throw new Error('請先登入你自己的原單字王帳號。');
+  const uid = user.uid, db = getFirestore(app), root = doc(db, 'users', uid);
+  const guard = () => { if (auth.currentUser?.uid !== uid) throw new Error('帳號已切換，匯出已取消。'); };
+  const before = (await getDocFromServer(root)).data() || {}; guard();
+  if (before.schemaVersion !== 6 || before.migrationV6?.status !== 'complete' || before.syncLock) throw new Error('資料尚未處於穩定的第 6 版狀態，請先在原站完成同步；工具不會遷移或修改資料。');
+  const names = ['wordOverrides', 'customWords', 'hiddenWords', 'folders'];
+  const rows = await Promise.all(names.map(name => getDocsFromServer(collection(root, name))));
+  const settings = await getDocFromServer(doc(root, 'settings', 'main')); guard();
+  const after = (await getDocFromServer(root)).data() || {}; guard();
+  if (after.schemaVersion !== 6 || after.syncLock || after.revision !== before.revision || JSON.stringify(after.migrationV6) !== JSON.stringify(before.migrationV6)) throw new Error('匯出途中資料有變更，請重新執行。');
+  const clean = data => Object.fromEntries(Object.entries(data).filter(([key]) => !['schemaVersion', 'updatedAt', 'createdAt', 'id'].includes(key)));
+  for (const group of rows) if (group.docs.some(row => row.data().schemaVersion > 6)) throw new Error('資料版本較新，匯出已取消。');
+  if (settings.exists() && settings.data().schemaVersion > 6) throw new Error('設定版本較新，匯出已取消。');
+  const modern = group => group.docs.filter(row => row.data().schemaVersion === 6);
+  const snapshot = { userOverrides: Object.fromEntries(modern(rows[0]).map(row => [row.id, clean(row.data())])),
+    customWords: Object.fromEntries(modern(rows[1]).map(row => [row.id, clean(row.data())])),
+    hiddenWordIds: modern(rows[2]).map(row => row.id), userFolders: Object.fromEntries(modern(rows[3]).map(row => [row.id, clean(row.data())])),
+    settings: settings.exists() && settings.data().schemaVersion === 6 ? clean(settings.data()) : {} };
+  const backup = { format: 'wordking-current-snapshot', version: 1, schemaVersion: 6, complete: true,
+    source: { app: 'wordking-original', uid, exportedAt: new Date().toISOString() }, snapshot };
+  const url = URL.createObjectURL(new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a'); link.href = url; link.download = 'wordking-current-snapshot.json'; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+  console.info('已下載目前帳號的完整備份。原站資料、帳號與其他使用者均未更改。');
+})();
diff --git a/scripts/buildRecommendationCatalog.mjs b/scripts/buildRecommendationCatalog.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..195e5028f0444abdb382c7aa79e6ac4058728edf
--- /dev/null
+++ b/scripts/buildRecommendationCatalog.mjs
@@ -0,0 +1,48 @@
+// Reproducible, conservative adapter over the already-reviewed local snapshots.
+// Run from admissions-site; the generated JSON also supports standalone restores.
+import { readFileSync, writeFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+const read = path => JSON.parse(readFileSync(path, "utf8"));
+const programs = Object.fromEntries(["113", "114", "115"].map(year => [year, read(`data/programs_${year}.json`)]));
+const detailed = { "114": read("data/program_learning_groups_114.json"), "115": read("data/program_learning_groups_115.json") };
+const groupIds = Object.fromEntries(["113", "114", "115"].map(year => [year, read(`data/program_learning_group_ids_${year}.json`)]));
+const hall = read("../game/data/universities.json").entries;
+const groups = read("data/interest_catalog.json").groups;
+const canonical = value => value.normalize("NFKC").replace(/\s/gu, "").replace(/學類$/u, "");
+const reliableKinds = new Set(["official-exact", "official-parent-department", "official-current-name-extension"]);
+const pairs = new Map();
+// One major or one group is unambiguous; never cross-multiply multi-major/multi-group arrays.
+for (const year of ["115", "114"]) for (const row of Object.values(detailed[year].programs)) {
+  if (!reliableKinds.has(row.matchKind) || row.officialCrossDomain || !row.officialMajorNames?.length) continue;
+  if (row.officialMajorNames.length !== 1 && row.learningGroupIds.length !== 1) continue;
+  for (const category of row.officialMajorNames.map(canonical)) for (const groupId of row.learningGroupIds) pairs.set(`${groupId}|${category}`, { groupId, category });
+}
+const catalog = [...pairs.values()].map(row => ({ ...row, groupLabel: groups.find(g => g.id === row.groupId).label })).sort((a,b) => groups.findIndex(g=>g.id===a.groupId)-groups.findIndex(g=>g.id===b.groupId) || a.category.localeCompare(b.category, "zh-Hant"));
+const schools = {};
+for (const year of ["113", "114", "115"]) for (const program of programs[year]) {
+  const candidates = hall.filter(entry => entry.name === program.schoolName || entry.aliases.includes(program.schoolName));
+  if (candidates.length > 1) throw new Error(`Ambiguous hall match ${program.schoolName}`);
+  if (year === "115" && candidates.length !== 1) throw new Error(`Missing 115 hall match ${program.schoolName}`);
+  schools[`${year}:${program.schoolId}`] = { schoolName: program.schoolName, universityId: candidates[0]?.id ?? "", match: candidates[0]?.name === program.schoolName ? "exact-name" : candidates.length ? "explicit-alias" : "unmapped" };
+}
+const mappings = {};
+for (const year of ["113", "114", "115"]) for (const program of programs[year]) {
+  let sourceYear = year, row = detailed[year]?.programs[program.programCode];
+  if (!row) for (const candidateYear of ["115", "114"]) {
+    const same = programs[candidateYear].filter(candidate => candidate.schoolId === program.schoolId && candidate.programName === program.programName);
+    if (same.length === 1) { row = detailed[candidateYear].programs[same[0].programCode]; sourceYear = candidateYear; break; }
+  }
+  const group = groupIds[year][program.programCode] ?? [];
+  const majors = [...new Set((row?.officialMajorNames ?? []).map(canonical))];
+  const reliable = !!row && reliableKinds.has(row.matchKind) && !row.officialCrossDomain;
+  const precise = reliable ? catalog.filter(pair => majors.includes(pair.category) && group.includes(pair.groupId)) : [];
+  mappings[`${year}:${program.programCode}`] = { groupIds: group, pairs: precise.map(({groupId,category})=>({groupId,category})), categories: majors,
+    reliable: reliable && precise.length > 0, matchKind: row?.matchKind ?? "group-only", crossDomain: row?.officialCrossDomain ?? false,
+    sourceYear, sourceUrl: row?.sourceUrl ?? detailed["115"].source.url };
+}
+const aliases = { "資工": "資訊工程", "資管": "資訊管理", "電機": "電機工程" };
+const sourceHash = createHash("sha256").update(JSON.stringify({ schools, mappings, catalog, aliases })).digest("hex").slice(0,16);
+const result = { schemaVersion: 1, dataVersion: `recommendation-catalog-${sourceHash}`, sourceNote: "Existing local CAC 113–115 and ColleGo classification snapshots; cross-year classifications explicitly retain sourceYear. Hall IDs joined by exact school name or explicit alias, never numerical IDs.",
+  aliases, catalog, schools, mappings };
+writeFileSync("data/recommendation_catalog.json", JSON.stringify(result, null, 2) + "\n");
+console.log(JSON.stringify({ dataVersion: result.dataVersion, catalog: catalog.length, schools115: Object.keys(schools).filter(key=>key.startsWith("115:")).length, mappings: Object.keys(mappings).length }));
