diff --git a/tests/forum.rules.test.ts b/tests/forum.rules.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bc2d016c12cb81e0d1e4fe74e8d89d8d5ae8b86c
--- /dev/null
+++ b/tests/forum.rules.test.ts
@@ -0,0 +1,82 @@
+import { beforeAll, beforeEach, afterAll, describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { initializeTestEnvironment, assertFails, assertSucceeds, type RulesTestEnvironment } from "@firebase/rules-unit-testing";
+import { collection, doc, getDoc, getDocs, query, limit, setDoc, updateDoc, deleteDoc, writeBatch, serverTimestamp, type Firestore } from "firebase/firestore";
+import { ForumRepository } from "../lib/forumRepository";
+import { ProfileRepository } from "../lib/accountProfile";
+import { deviceThreadId } from "../lib/forumDevices";
+describe.skipIf(!process.env.FIRESTORE_EMULATOR_HOST)("profile and forum ownership (Firestore Emulator)", () => {
+  let env:RulesTestEnvironment;
+  beforeAll(async()=>{ env=await initializeTestEnvironment({projectId:'demo-starpath-forum',firestore:{rules:readFileSync(new URL('../firestore.rules',import.meta.url),'utf8'),host:'127.0.0.1',port:8080}}); });
+  beforeEach(async()=>{await env.clearFirestore();}); afterAll(async()=>{await env?.cleanup();});
+  function db(uid:string) {return env.authenticatedContext(uid).firestore() as unknown as Firestore;}
+  async function member(uid:string) {const store=db(uid); await new ProfileRepository(store,uid).save({schemaVersion:1,nickname:uid==='alice'?'小星':'同學',identity:'graduate'}); return store;}
+  const id='A'.repeat(20), rid='B'.repeat(20);
+  it('atomically admits one owner per device and preserves all other slots',async()=>{
+    const alice=await member('alice'),bob=await member('bob'),a=new ForumRepository(alice,'alice'),b=new ForumRepository(bob,'bob');
+    const first=deviceThreadId('campus',0,2),second=deviceThreadId('campus',0,7);
+    const race=await Promise.allSettled([a.createThread(first,'campus','甲先寫',false),b.createThread(first,'campus','乙先寫',true)]);
+    expect(race.filter(result=>result.status==='fulfilled')).toHaveLength(1);
+    await b.createThread(second,'campus','另一座裝置',false);
+    const slots=await a.listDevices('campus',0);
+    expect(slots).toHaveLength(8); expect(slots.filter(Boolean)).toHaveLength(2);
+    expect(slots[2]?.id).toBe(first); expect(slots[7]?.id).toBe(second); expect(slots[0]).toBeNull();
+    await a.createThread(id,'campus','舊版留言保留',false);
+    expect((await a.listDevices('campus',0))[2]?.body).toBe(slots[2]?.body);
+    expect((await a.get(id))?.body).toBe('舊版留言保留');
+    const owner=await a.owns(first)?a:b;
+    await owner.edit(first,'原位置編輯'); expect((await b.listDevices('campus',0))[2]?.body).toBe('原位置編輯');
+    await owner.remove(first); expect((await a.listDevices('campus',0))[2]?.deleted).toBe(true);
+    await expect(b.createThread(first,'campus','不能覆蓋刪除位置',false)).rejects.toThrow();
+  });
+  it('enforces reserved device zone and range at the rules boundary',async()=>{
+    const alice=await member('alice');
+    for(const thread of [deviceThreadId('major',0,0),'SPDEVCL0000010000000']) {
+      const batch=writeBatch(alice);
+      batch.set(doc(alice,'discussionThreads',thread),{schemaVersion:1,zone:'campus',body:'錯誤區域',authorName:'小星',identity:'graduate',anonymous:false,deleted:false,createdAt:serverTimestamp(),updatedAt:serverTimestamp()});
+      batch.set(doc(alice,'users/alice/discussionClaims',thread),{kind:'thread',threadId:thread,createdAt:serverTimestamp()});
+      await assertFails(batch.commit());
+    }
+  });
+  it('keeps profiles private and rejects missing/invalid roles', async()=>{
+    const alice=await member('alice');
+    await assertFails(getDoc(doc(db('bob'),'users/alice/profile/main')));
+    await assertFails(setDoc(doc(db('bob'),'users/bob/profile/main'),{schemaVersion:1,nickname:'同學',identity:'unknown',createdAt:serverTimestamp(),updatedAt:serverTimestamp()}));
+    await assertFails(getDocs(query(collection(db('bob'),'discussionThreads'),limit(9))));
+    await assertSucceeds(new ProfileRepository(alice,'alice').save({schemaVersion:1,nickname:'新暱稱',identity:'professional'}));
+  });
+  it('creates anonymous root and named reply with private atomic ownership; supports retry, edit, tombstone', async()=>{
+    const alice=await member('alice'),bob=await member('bob'),a=new ForumRepository(alice,'alice'),b=new ForumRepository(bob,'bob');
+    await a.createThread(id,'campus','第一行\n第二行',true); await a.createThread(id,'campus','第一行\n第二行',true);
+    await b.createReply(id,rid,'很有幫助',false);
+    const root=(await getDoc(doc(bob,'discussionThreads',id))).data()!;
+    expect(root.authorName).toBe('匿名'); expect(root.identity).toBe('graduate');
+    expect(Object.keys(root).sort()).toEqual(['schemaVersion','zone','body','authorName','identity','anonymous','deleted','createdAt','updatedAt'].sort());
+    expect((await a.list('campus')).records).toHaveLength(1); expect((await b.listReplies(id)).records).toHaveLength(1);
+    await assertFails(getDoc(doc(bob,'users/alice/discussionClaims',id)));
+    await expect(b.edit(id,'冒名')).rejects.toThrow();
+    await a.edit(id,'已更新'); await b.edit(id,'回覆更新',rid); await a.remove(id);
+    expect((await b.get(id))?.deleted).toBe(true); expect((await b.listReplies(id)).records[0].body).toBe('回覆更新');
+    await expect(b.createReply(id,'C'.repeat(20),'再回覆',true)).rejects.toThrow();
+    await assertFails(deleteDoc(doc(alice,'discussionThreads',id)));
+  });
+  it('denies claim theft, public stable identifiers, author/role changes and unbounded queries', async()=>{
+    const alice=await member('alice'),bob=await member('bob'),a=new ForumRepository(alice,'alice'); await a.createThread(id,'university','你好',false);
+    await assertFails(setDoc(doc(bob,'users/bob/discussionClaims',id),{kind:'thread',threadId:id,createdAt:serverTimestamp()}));
+    await assertFails(updateDoc(doc(alice,'discussionThreads',id),{authorUid:'alice',updatedAt:serverTimestamp()}));
+    await assertFails(updateDoc(doc(alice,'discussionThreads',id),{identity:'university',updatedAt:serverTimestamp()}));
+    await assertFails(updateDoc(doc(alice,'discussionThreads',id),{authorName:'another',updatedAt:serverTimestamp()}));
+    await assertFails(getDocs(collection(alice,'discussionThreads'))); await assertFails(getDocs(query(collection(alice,'discussionThreads'),limit(10))));
+    await assertFails(getDocs(query(collection(alice,'discussionThreads',id,'replies'),limit(22))));
+    await assertFails(getDoc(doc(env.unauthenticatedContext().firestore(),'discussionThreads',id)));
+  });
+  it('requires claim and message together, rejects anonymous leaks and long body at rules boundary',async()=>{
+    const alice=await member('alice');
+    const body={schemaVersion:1,zone:'major',body:'hi',authorName:'匿名',identity:'graduate',anonymous:true,deleted:false,createdAt:serverTimestamp(),updatedAt:serverTimestamp()};
+    await assertFails(setDoc(doc(alice,'discussionThreads',id),body));
+    for(const patch of [{authorName:'小星'},{body:'x'.repeat(2001)},{ownerUid:'alice'},{body:'   '}]) {
+      const batch=writeBatch(alice); batch.set(doc(alice,'discussionThreads',id),{...body,...patch}); batch.set(doc(alice,'users/alice/discussionClaims',id),{kind:'thread',threadId:id,createdAt:serverTimestamp()}); await assertFails(batch.commit());
+    }
+    const batch=writeBatch(alice); batch.set(doc(alice,'discussionThreads',id),body); batch.set(doc(alice,'users/alice/discussionClaims',id),{kind:'thread',threadId:id,createdAt:serverTimestamp()}); await assertSucceeds(batch.commit());
+  });
+});
