+"use client";
+import { useId, useState } from "react";
+import { useAccount } from "./AccountProvider";
+import { useExamRecords } from "./useExamRecords";
+import type { ExamRepository } from "../lib/examRepository";
+import { describeScores, type ExamKind, type ExamRecord } from "../lib/examRecords";
+import { sitePath } from "../config/sitePaths";
+import { currentWorkbench, workbenchUtilityPath } from "../lib/workbench";
+import { lastAdmissionYear } from "../lib/privateSession";
+
+export function SavedExamPicker({ onApply }: { onApply: (record: ExamRecord) => void }) {
+  const { user, runtime, loading, error, retry } = useAccount();
+  const [expanded, setExpanded] = useState(false);
+  const panelId = useId();
+  return <section className="saved-exam-picker" aria-label="選用已儲存成績">
+    <div className="saved-exam-heading"><div><span className="eyebrow">從紀錄開始</span><h3>選用已儲存的成績</h3>
+      <p>直接帶入某次模擬考或練習，接著調整級分與校系。</p></div>
+      <button type="button" className="saved-exam-toggle" aria-expanded={expanded} aria-controls={panelId} onClick={() => setExpanded((value) => !value)}>{expanded ? "收起紀錄" : "選擇成績"}<span aria-hidden="true">{expanded ? "−" : "+"}</span></button></div>
+    {expanded && <div className="saved-exam-panel" id={panelId}>
+      {loading ? <p role="status">正在確認登入狀態…</p> : error ? <div role="alert"><p>{error}</p><button type="button" onClick={retry}>重新連線</button></div> : !user || !runtime ?
+        <p className="saved-exam-guest">登入後，就能在這裡選用你的成績紀錄。<a href={sitePath(workbenchUtilityPath("/account/", currentWorkbench(), lastAdmissionYear()))}>前往登入 →</a></p> :
+        <SavedExamChoices key={user.uid} repository={runtime.exams(user.uid)} onApply={onApply} />}
+    </div>}
+  </section>;
+}
+
+function SavedExamChoices({ repository, onApply }: { repository: ExamRepository; onApply: (record: ExamRecord) => void }) {
+  const { records, hasMore, loading, error, load, retry } = useExamRecords(repository);
+  const [kind, setKind] = useState<"all" | ExamKind>("all");
+  const [applied, setApplied] = useState<ExamRecord | null>(null);
+  const visible = records.filter((record) => kind === "all" || record.kind === kind);
+  return <>
+    <div className="saved-exam-toolbar"><div className="saved-exam-filters" role="group" aria-label="選用成績類型">
+      {([["all", "全部"], ["mock", "模擬考"], ["practice", "自行練習"]] as const).map(([value, label]) =>
+        <button type="button" key={value} aria-pressed={kind === value} onClick={() => setKind(value)}>{label}</button>)}
+    </div><button type="button" className="text-button" disabled={loading} onClick={() => void load()}>重新整理</button></div>
+    {error && <div className="cloud-error" role="alert"><p>{error}</p><button type="button" disabled={loading} onClick={() => void retry()}>重試讀取</button></div>}
+    <div className="saved-exam-list">{visible.map((record) => <article className="saved-exam-option" key={record.id}>
+      <div><div className="saved-exam-meta"><span className={`exam-kind ${record.kind}`}>{record.kind === "mock" ? "模擬考" : "自行練習"}</span><time dateTime={record.examDate}>{record.examDate.replaceAll("-", "/")}</time></div>
+        <h4>{record.title}</h4><p>{describeScores(record)}</p></div>
+      <button type="button" aria-label={`帶入 ${record.title}（${record.examDate}）`} onClick={() => { onApply(record); setApplied(record); }}>帶入<span aria-hidden="true"> ↓</span></button>
+    </article>)}</div>
+    {!visible.length && !loading && !error && <p className="saved-exam-empty">{hasMore ? "已載入的紀錄中沒有這類成績，可繼續載入較早紀錄。" : records.length ? "目前沒有這類成績。可切換類型，或直接在下方填寫。" : "還沒有儲存過成績。先在下方填寫，再到頁面底部儲存第一筆紀錄。"}</p>}
+    {loading && <p role="status">正在讀取成績…</p>}
+    {hasMore && <button type="button" className="saved-exam-more" disabled={loading} onClick={() => void load(true)}>載入較早紀錄</button>}
+    {records.length > 0 && <p className="saved-exam-footnote">已載入 {records.length} 筆，顯示 {visible.length} 筆{hasMore ? "；類型篩選適用於已載入紀錄" : ""}。</p>}
+    {applied && <p className="saved-exam-applied" role="status">已帶入「{applied.title}」。目前年度、校系篩選保持不變；可直接調整下方級分，原紀錄不會被修改。</p>}
+  </>;
+}
