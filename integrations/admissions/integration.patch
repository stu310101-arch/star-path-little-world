+  const { view, source: frameSource } = navigation;
+  const analysisView = useRef<"general" | "apcs" | "special" | null>(null);
+  const [frameVisit, setFrameVisit] = useState(0);
+  const suspended = useRef(false);
+  const pairingEpoch = useRef(0);
