+import { describe, expect, it } from "vitest";
+import { emptyWordKingState, makeWordKingBackup, previewWordKingImport, validateWordKingState } from "../lib/wordkingSnapshot";
+
+describe("complete WordKing snapshot import", () => {
+  it("keeps overrides, custom meanings, explicit false/wrong flags, folders, hidden IDs and settings", async () => {
+    const state = { ...emptyWordKingState(), userOverrides: { apple: { isWrong: false, meanings: [{ partOfSpeech: "noun", definitions: ["蘋果"] }] } },
+      customWords: { c_abc: { english: "my word", meanings: [{ partOfSpeech: "noun", definitions: ["自訂"] }], isWrong: true, folderIds: ["f_one"], lessonIds: [] } },
+      hiddenWordIds: ["hidden_word"], userFolders: { f_one: { name: "自己的資料夾" } }, settings: { hiddenLessonIds: ["lesson_2"], lessonFolderNames: { lesson_1: "更名" }, bgmVolume: 0 } };
+    const preview = await previewWordKingImport(makeWordKingBackup(state, "own-user"));
+    expect(preview.backup.snapshot).toEqual(state); expect(preview.counts).toEqual({ overrides: 1, customWords: 1, hiddenWords: 1, folders: 1, wrongWords: 1 });
+    expect(preview.libraryId).toMatch(/^import_[a-f0-9]{64}$/); expect(preview.libraryId).not.toBe("main");
+  });
+  it("makes retries deterministic despite key order and export timestamps", async () => {
+    const backup = makeWordKingBackup(emptyWordKingState(), "source-user"), first = await previewWordKingImport(backup);
+    const second = await previewWordKingImport({ ...backup, source: { ...backup.source, exportedAt: "2026-10-23T04:00:00Z" }, snapshot: { settings: {}, userFolders: {}, hiddenWordIds: [], customWords: {}, userOverrides: {} } });
+    expect(second.sourceHash).toBe(first.sourceHash);
+    expect((await previewWordKingImport({ ...backup, source: { ...backup.source, uid: "another-user" } })).sourceHash).not.toBe(first.sourceHash);
+  });
+  it("rejects historical recovery backups and incomplete/invalid data without normalization loss", async () => {
+    await expect(previewWordKingImport({ schemaVersion: 6, backupId: "old", sources: {}, conflicts: [] })).rejects.toThrow("遷移備份");
+    expect(() => validateWordKingState({ userOverrides: {} })).toThrow("五種");
+    expect(() => validateWordKingState({ ...emptyWordKingState(), userOverrides: { x: { isWrong: "false" } } })).toThrow("true");
+    expect(() => validateWordKingState(JSON.parse('{"userOverrides":{"__proto__":{}},"customWords":{},"hiddenWordIds":[],"userFolders":{},"settings":{}}'))).toThrow();
+  });
+  it("accepts a complete empty account", async () => { expect((await previewWordKingImport(makeWordKingBackup(emptyWordKingState(), "empty"))).counts.customWords).toBe(0); });
+});
