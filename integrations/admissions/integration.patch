diff --git a/lib/progressProtocol.ts b/lib/progressProtocol.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5d5cb396e73f34e3a0aa9149eb73d0ff54d7d08e
--- /dev/null
+++ b/lib/progressProtocol.ts
@@ -0,0 +1,27 @@
+import type { ProgressRepository } from "./progressRepository";
+export type ProgressCommand = { requestId: string; sessionGeneration: number } & ({ action: "university-get" } | { action: "university-favorite"; id: string; value: boolean } | { action: "university-explored"; id: string } | { action: "university-import"; visited_ids: string[]; favorite_ids: string[] });
+export function readProgressCommand(input: unknown): ProgressCommand | null {
+  try {
+    if (typeof input === "string") { if (new TextEncoder().encode(input).length > 4096) return null; input = JSON.parse(input); }
+    if (!input || typeof input !== "object" || Array.isArray(input)) return null;
+    const data = input as Record<string, unknown>;
+    if (typeof data.requestId !== "string" || !/^[A-Za-z0-9_-]{1,64}$/.test(data.requestId) || !Number.isSafeInteger(data.sessionGeneration) || Number(data.sessionGeneration) < 0) return null;
+    const base = { requestId: data.requestId, sessionGeneration: Number(data.sessionGeneration) };
+    if (data.action === "university-get") return { ...base, action: data.action };
+    if ((data.action === "university-favorite" || data.action === "university-explored") && typeof data.id === "string" && /^\d{3}$/.test(data.id)) {
+      if (data.action === "university-explored") return { ...base, action: data.action, id: data.id };
+      if (typeof data.value === "boolean") return { ...base, action: data.action, id: data.id, value: data.value };
+    }
+    if (data.action === "university-import" && [data.visited_ids, data.favorite_ids].every(value => Array.isArray(value) && value.length <= 138 && value.every(id => typeof id === "string" && /^\d{3}$/.test(id)))) return { ...base, action: data.action, visited_ids: [...data.visited_ids as string[]], favorite_ids: [...data.favorite_ids as string[]] };
+  } catch { /* Malformed input never reaches storage. */ }
+  return null;
+}
+export async function executeProgressCommand(command: ProgressCommand, repository: ProgressRepository, current: () => boolean, emit: (packet: Record<string, unknown>) => void): Promise<void> {
+  const base = { channel: "starpath-progress", version: 1, app: "university", requestId: command.requestId, sessionGeneration: command.sessionGeneration };
+  try {
+    const state = command.action === "university-get" ? await repository.getUniversity() : command.action === "university-favorite" ? await repository.setUniversityFavorite(command.id, command.value) : command.action === "university-explored" ? await repository.markUniversityExplored(command.id) : await repository.importUniversity({ visited_ids: command.visited_ids, favorite_ids: command.favorite_ids });
+    const packet = { ...base, type: "state", ...state };
+    if (new TextEncoder().encode(JSON.stringify(packet)).length > 4096) throw new Error("progress-too-large");
+    if (current()) emit(packet);
+  } catch { if (current()) emit({ ...base, type: "error", message: "大學館進度暫時無法同步，請確認網路後重試。" }); }
+}
diff --git a/lib/progressRepository.ts b/lib/progressRepository.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fd0c4f50d00211a37de2f067eda91d98376dfe16
--- /dev/null
+++ b/lib/progressRepository.ts
@@ -0,0 +1,66 @@
+import { doc, getDocFromServer, runTransaction, serverTimestamp, type Firestore } from "firebase/firestore";
+import { validPrivateId } from "./wordkingSnapshot";
+
+export type UniversityProgress = { favorites: Record<string, boolean>; explored: string[]; revision: number };
+const universityId = (id: unknown): id is string => typeof id === "string" && /^\d{3}$/.test(id) && Number(id) >= 1 && Number(id) <= 138;
+export function mergeUniversityProgress(current: UniversityProgress, action: { id: string; favorite: boolean } | { explored: string[] } | { import: { visited_ids: string[]; favorite_ids: string[] } }): UniversityProgress {
+  const favorites = { ...current.favorites }, explored = new Set(current.explored);
+  if ("id" in action) {
+    if (!universityId(action.id) || typeof action.favorite !== "boolean") throw new Error("學校收藏資料無效。");
+    favorites[action.id] = action.favorite;
+  } else if ("explored" in action) {
+    for (const id of action.explored) { if (!universityId(id)) throw new Error("學校探索資料無效。"); explored.add(id); }
+  } else {
+    for (const id of action.import.visited_ids) { if (!universityId(id)) throw new Error("本機探索資料無效。"); explored.add(id); }
+    // A cloud false is an explicit removal, not a missing value: old imports cannot resurrect it.
+    for (const id of action.import.favorite_ids) { if (!universityId(id)) throw new Error("本機收藏資料無效。"); if (!Object.hasOwn(favorites, id)) favorites[id] = true; }
+  }
+  return { favorites, explored: [...explored].sort(), revision: current.revision + 1 };
+}
+export function validateGoSave(input: unknown): Record<string, unknown> {
+  if (!input || typeof input !== "object") throw new Error("圍棋存檔格式無效。");
+  const data = JSON.parse(JSON.stringify(input));
+  const game = data.game, settings = data.settings;
+  if (data.version !== 1 || data.started === false || !settings || !game || ![9, 13, 19].includes(game.size) || game.komi !== 6.5 ||
+      !Array.isArray(game.board) || game.board.length !== game.size * game.size || game.board.some((stone: unknown) => ![0, 1, 2].includes(stone as number)) ||
+      !Array.isArray(game.history) || !Number.isInteger(game.moveNumber) || game.history.length !== game.moveNumber ||
+      !["ai", "local"].includes(settings.mode) || !["easy", "medium", "hard"].includes(settings.difficulty)) throw new Error("圍棋存檔內容不完整。");
+  if (new TextEncoder().encode(JSON.stringify(data)).length > 750000) throw new Error("棋局歷史超過雲端單局容量，請先匯出存檔。");
+  return data;
+}
+export class ProgressRepository {
+  constructor(private db: Firestore, private uid: string, private currentUid: () => string | null = () => uid) {}
+  private guard() { if (!validPrivateId(this.uid) || this.currentUid() !== this.uid) throw Object.assign(new Error("帳號已切換，請重新開啟遊戲。"), { code: "stale-user-session" }); }
+  private ref(name: "university" | "go") { return doc(this.db, "users", this.uid, "gameProgress", name); }
+  private university(data?: Record<string, unknown>): UniversityProgress {
+    return data ? { favorites: Object.fromEntries(Object.entries(data.favorites as Record<string, boolean> || {}).filter(([id, value]) => universityId(id) && typeof value === "boolean")),
+      explored: [...new Set((data.explored as string[] || []).filter(universityId))], revision: Number(data.revision) || 0 } : { favorites: {}, explored: [], revision: 0 };
+  }
+  async getUniversity() { this.guard(); const snap = await getDocFromServer(this.ref("university")); this.guard(); return this.university(snap.data()); }
+  private async mutateUniversity(action: Parameters<typeof mergeUniversityProgress>[1]) {
+    this.guard(); return runTransaction(this.db, async tx => {
+      const ref = this.ref("university"), snap = await tx.get(ref); this.guard();
+      const next = mergeUniversityProgress(this.university(snap.data()), action);
+      tx.set(ref, { schemaVersion: 1, ...next, updatedAt: serverTimestamp() }); return next;
+    });
+  }
+  setUniversityFavorite(id: string, value: boolean) { return this.mutateUniversity({ id, favorite: value }); }
+  markUniversityExplored(id: string) { return this.mutateUniversity({ explored: [id] }); }
+  importUniversity(input: { visited_ids: string[]; favorite_ids: string[] }) {
+    if (!Array.isArray(input?.visited_ids) || !Array.isArray(input?.favorite_ids) || input.visited_ids.length > 138 || input.favorite_ids.length > 138) throw new Error("本機大學館存檔無效。");
+    return this.mutateUniversity({ import: { visited_ids: [...input.visited_ids], favorite_ids: [...input.favorite_ids] } });
+  }
+  async loadGo() { this.guard(); const snap = await getDocFromServer(this.ref("go")); this.guard();
+    return snap.exists() ? { state: validateGoSave(JSON.parse(snap.data().json)), revision: Number(snap.data().revision) } : { state: null, revision: 0 };
+  }
+  async saveGo(input: unknown, expectedRevision: number) {
+    this.guard(); const state = validateGoSave(input), json = JSON.stringify(state);
+    return runTransaction(this.db, async tx => {
+      const ref = this.ref("go"), snap = await tx.get(ref); this.guard(); const revision = snap.exists() ? Number(snap.data().revision) : 0;
+      if (revision !== expectedRevision) throw Object.assign(new Error("其他裝置已更新棋局，請重新開啟圍棋後再繼續。"), { code: "cloud-revision-conflict" });
+      tx.set(ref, { schemaVersion: 1, json, revision: revision + 1, updatedAt: serverTimestamp() }); return { revision: revision + 1 };
+    });
+  }
+  // Only an explicit import into an empty cloud slot is accepted; existing cloud games are preserved.
+  importGo(input: unknown) { return this.saveGo(input, 0); }
+}
