# Release files have SHA-256 checksums and must keep their exact bytes on every OS.
deploy/github-pages/files/** -text
deploy/github-pages/parts/** -text
*.glb -text
*.blend -text
*.wasm -text
*.pck -text

# Keep hand-authored code with consistent line endings in the repository.
*.gd text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.md text eol=lf
